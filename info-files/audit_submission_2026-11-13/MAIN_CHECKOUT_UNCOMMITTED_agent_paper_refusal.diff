+test('checkSettings refuses A3 or Letter when the printer paper list is unknown (Windows), but still allows A4', () => {
+  // Windows reports papers: null. A non-A4 job would print on the default tray while the customer was charged for the size.
+  const windows = { ...OFFICE, papers: null };
+  const a4 = { copies: 1, colour: false, duplex: false, paper: 'A4' };
+  assert.equal(checkSettings(a4, windows), null);
+  assert.equal(checkSettings({ ...a4, paper: 'a4' }, windows), null);
+  for (const paper of ['A3', 'Letter']) {
+    const refusal = checkSettings({ ...a4, paper }, windows);
+    assert.equal(refusal.code, 'unsupported_setting');
+    assert.match(refusal.message, new RegExp(`${paper} paper`));
+  }
+  // An empty list is unknown too, not "supports nothing".
+  assert.equal(checkSettings({ ...a4, paper: 'A3' }, { ...OFFICE, papers: [] }).code, 'unsupported_setting');
+  // A printer that reports a list still decides by that list.
+  assert.equal(checkSettings({ ...a4, paper: 'A3' }, { ...OFFICE, papers: ['A3', 'A4'] }), null);
+});
