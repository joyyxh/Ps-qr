+test('a picture order on A3 or Letter fails before anything is sent, because pictures are wrapped on A4 only', async (t) => {
+  // The printer lists A3 and Letter, so checkSettings passes and the picture rule is what refuses the job.
+  for (const paper of ['A3', 'Letter']) {
+    const h = await harness(t, {
+      printers: [{ ...OFFICE, papers: ['A4', 'A3', 'Letter'] }],
+      acceptsImages: false,
+      bytes: JPEG,
+    });
+    await h.worker.processJob(job({ size_bytes: JPEG.length, settings: { copies: 1, colour: false, duplex: false, paper } }));
+    assert.deepEqual(h.events, ['failed'], paper);
+    assert.equal(h.reports[0].result.errorCode, 'unsupported_setting', paper);
+    assert.match(h.reports[0].result.errorMessage, new RegExp(`for ${paper};`), paper);
+  }
+});
