+
+test('with the view on, the owner gets one check and staff get none (control for the test above)', async () => {
+  const calls = [];
+  const app = { innerHTML: '', querySelector: () => null };
+  const pages = createLicencePages({
+    app,
+    ownerApi: {
+      shopLicenceStatus: async (shopId) => {
+        calls.push(shopId);
