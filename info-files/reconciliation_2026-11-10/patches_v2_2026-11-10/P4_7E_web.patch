+    isOnline: () => true,
+  });
+  await pages.open({ id: SHOP_A, slug: 'alpha', name: 'Alpha', role: 'owner' });
+  assert.deepEqual(calls, []);
+  assert.equal(app.innerHTML, 'unchanged');
