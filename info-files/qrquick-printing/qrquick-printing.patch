--- /dev/null
+++ b/agent/src/sample-page.mjs
@@ -0,0 +1,35 @@
+// A one-page A4 text PDF for "test-print". It uses the built-in Helvetica font, so
+// nothing needs to be embedded. Non-ASCII characters are replaced with "?".
+
+function escapeText(text) {
+  return String(text).replace(/[^\x20-\x7e]/g, '?').replace(/[\\()]/g, '\\$&');
+}
+
+export function buildSamplePdf(lines) {
+  const body = lines
+    .map((line, i) => `/F1 ${i === 0 ? 22 : 14} Tf 1 0 0 1 72 ${760 - i * 28} Tm (${escapeText(line)}) Tj`)
+    .join('\n');
+  const content = `BT\n${body}\nET\n`;
+
+  const objects = [
+    '<< /Type /Catalog /Pages 2 0 R >>',
+    '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
+    '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595.28 841.89] /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>',
+    `<< /Length ${Buffer.byteLength(content, 'latin1')} >>\nstream\n${content}endstream`,
+    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',
+  ];
+
+  let text = '%PDF-1.4\n';
+  const offsets = [];
+  objects.forEach((object, index) => {
+    offsets.push(Buffer.byteLength(text, 'latin1'));
+    text += `${index + 1} 0 obj\n${object}\nendobj\n`;
+  });
+  const xrefOffset = Buffer.byteLength(text, 'latin1');
+  text += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`;
+  for (const offset of offsets) {
+    text += `${String(offset).padStart(10, '0')} 00000 n \n`;
+  }
+  text += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF\n`;
+  return Buffer.from(text, 'latin1');
+}
diff --git a/agent/src/worker.mjs b/agent/src/worker.mjs
new file mode 100644
index 0000000..b6899ed
--- /dev/null
+++ b/agent/src/worker.mjs
@@ -0,0 +1,334 @@
+// The agent's main loop. It keeps the server informed, takes one job at a time,
+// checks that the chosen printer can do what the order asks, and prints only after
+// the server has recorded that printing has started.
+//
+// Duplicate prevention, in order:
+//   1. The server hands a job to one agent at a time (a lease).
+//   2. The agent asks the server to record "printing" before it sends the file.
+//      If that fails, or the server says the job was taken back, nothing is printed.
+//   3. The agent writes a note to disk before sending and after it is accepted, so a
+//      restart knows whether a job may already have been printed. Reports that could
+//      not be sent yet are kept and sent later.
+//   4. The server never requeues a job that reached "printing". It asks the owner.
+
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { AgentApiError, downloadFile } from './api.mjs';
+import { detectFileType, MAX_FILE_BYTES } from './file-check.mjs';
+import { imageToPdf } from './image-to-pdf.mjs';
+
+export class AgentRevokedError extends Error {
+  constructor() {
+    super('This computer was removed from QRquick. Pair it again to print.');
+    this.name = 'AgentRevokedError';
+  }
+}
+
+function safeMessage(err) {
+  return String(err?.message ?? 'Unknown problem').slice(0, 300);
+}
+
+// The server only accepts short lower-case codes. Anything else (for example a Node
+// "ENOENT") is replaced with the fallback, so the job result is never rejected.
+function codeOf(err, fallback) {
+  return typeof err?.code === 'string' && /^[a-z_]{1,60}$/.test(err.code) ? err.code : fallback;
+}
+
+// Settings from the order. Anything outside the expected shape stops the job.
+export function normaliseSettings(raw) {
+  const settings = raw && typeof raw === 'object' ? raw : {};
+  const copies = Number.isInteger(settings.copies) ? settings.copies : 1;
+  if (copies < 1 || copies > 100) {
+    const err = new Error('The number of copies must be between 1 and 100.');
+    err.code = 'bad_settings';
+    throw err;
+  }
+  return {
+    copies,
+    colour: settings.colour === true,
+    duplex: settings.duplex === true,
+    paper: typeof settings.paper === 'string' && settings.paper.length <= 10 ? settings.paper : 'A4',
+  };
+}
+
+// The printer the server chose, else the one set on this computer, else the system default.
+export function choosePrinter({ printers, wanted = null, configured = null }) {
+  const name = wanted || configured || null;
+  if (name) return printers.find((p) => p.name === name) ?? null;
+  return printers.find((p) => p.isDefault) ?? null;
+}
+
+// Returns null when the printer can do the job, else { code, message }.
+export function checkSettings(settings, printer) {
+  if (!printer.enabled) {
+    return { code: 'printer_offline', message: `"${printer.name}" is turned off or offline.` };
+  }
+  if (!printer.capabilitiesKnown && (settings.colour || settings.duplex)) {
+    return {
+      code: 'printer_unknown',
+      message: `QRquick could not read the options of "${printer.name}". Check the printer is set up on this computer.`,
+    };
+  }
+  if (settings.colour && !printer.colour) {
+    return {
+      code: 'unsupported_setting',
+      message: `This order is in colour, but "${printer.name}" does not print in colour. Use a colour printer.`,
+    };
+  }
+  if (settings.duplex && !printer.duplex) {
+    return {
+      code: 'unsupported_setting',
+      message: `This order is double-sided, but "${printer.name}" cannot print on both sides.`,
+    };
+  }
+  if (Array.isArray(printer.papers) && printer.papers.length > 0) {
+    const supported = printer.papers.some((p) => p.toLowerCase() === settings.paper.toLowerCase());
+    if (!supported) {
+      return {
+        code: 'unsupported_setting',
+        message: `${settings.paper} paper is not supported by "${printer.name}".`,
+      };
+    }
+  }
+  return null;
+}
+
+export function toServerPrinter(p) {
+  return {
+    name: p.name,
+    isDefault: p.isDefault === true,
+    enabled: p.enabled !== false,
+    capabilitiesKnown: p.capabilitiesKnown === true,
+    colour: p.colour === true,
+    duplex: p.duplex === true,
+    papers: Array.isArray(p.papers) ? p.papers.slice(0, 20) : null,
+  };
+}
+
+export function createWorker({
+  api,
+  adapter,
+  journal,
+  download = (url, options) => downloadFile(url, options),
+  config = {},
+  workDir = path.join(os.tmpdir(), 'qrquick-agent'),
+  log = () => {},
+  sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms)),
+  now = () => Date.now(),
+  pollMs = 5000,
+  heartbeatMs = 30000,
+  version = '0.1.0',
+}) {
+  let lastHeartbeat = 0;
+  let failures = 0;
+
+  async function sendHeartbeat() {
+    let printers = [];
+    try {
+      printers = (await adapter.listPrinters()).map(toServerPrinter);
+    } catch (err) {
+      log(`Could not read the printers: ${safeMessage(err)}`);
+    }
+    try {
+      await api.heartbeat({ version, printers });
+      lastHeartbeat = now();
+    } catch (err) {
+      if (err instanceof AgentApiError && err.status === 401) throw new AgentRevokedError();
+      log(`Could not send status: ${safeMessage(err)}`);
+    }
+  }
+
+  // Sends results that could not be sent earlier. Ones the server no longer expects are dropped.
+  async function flushReports() {
+    const state = await journal.read();
+    for (const report of state.pendingReports) {
+      try {
+        await api.finish(report, {
+          outcome: report.outcome,
+          errorCode: report.errorCode ?? null,
+          errorMessage: report.errorMessage ?? null,
+        });
+        await journal.removeReport(report.jobId, report.attempt);
+      } catch (err) {
+        if (err instanceof AgentApiError && err.status === 401) throw new AgentRevokedError();
+        if (err instanceof AgentApiError && err.status >= 400 && err.status < 500 && err.status !== 429) {
+          log(`A job result was not needed any more and was dropped (${err.code}).`);
+          await journal.removeReport(report.jobId, report.attempt);
+          continue;
+        }
+        log('A job result is waiting to be sent. It will be retried.');
+        return;
+      }
+    }
+  }
+
+  async function report(jobRef, outcome, errorCode = null, errorMessage = null) {
+    try {
+      await api.finish(jobRef, { outcome, errorCode, errorMessage });
+    } catch (err) {
+      if (err instanceof AgentApiError && err.status === 401) throw new AgentRevokedError();
+      if (err instanceof AgentApiError && err.status === 409) return; // the server already moved on
+      if (err instanceof AgentApiError && err.status >= 400 && err.status < 500 && err.status !== 429) {
+        log(`The server did not accept a job result (${err.code}).`);
+        return;
+      }
+      await journal.addReport({ ...jobRef, outcome, errorCode, errorMessage });
+    }
+  }
+
+  async function processJob(job) {
+    const jobRef = { jobId: job.job_id, attempt: job.attempt };
+    const label = `Job ${String(job.job_id).slice(0, 8)} (attempt ${job.attempt})`;
+
+    let settings;
+    try {
+      settings = normaliseSettings(job.settings);
+    } catch (err) {
+      log(`${label}: the order settings are not valid.`);
+      await report(jobRef, 'failed', err.code ?? 'bad_settings', safeMessage(err));
+      return;
+    }
+
+    let printers;
+    try {
+      printers = await adapter.listPrinters();
+    } catch (err) {
+      log(`${label}: ${safeMessage(err)}`);
+      await report(jobRef, 'failed', codeOf(err, 'print_engine_missing'), safeMessage(err));
+      return;
+    }
+    const printer = choosePrinter({ printers, wanted: job.printer, configured: config.printer });
+    if (!printer) {
+      const name = job.printer || config.printer;
+      const message = name
+        ? `The printer "${name}" is not connected to this computer.`
+        : 'No printer is set up on this computer.';
+      log(`${label}: ${message}`);
+      await report(jobRef, 'failed', 'printer_not_found', message);
+      return;
+    }
+    const problem = checkSettings(settings, printer);
+    if (problem) {
+      log(`${label}: ${problem.message}`);
+      await report(jobRef, 'failed', problem.code, problem.message);
+      return;
+    }
+
+    let bytes;
+    try {
+      bytes = await download(job.file_url, { maxBytes: MAX_FILE_BYTES });
+    } catch (err) {
+      log(`${label}: the file could not be downloaded.`);
+      await report(jobRef, 'failed', codeOf(err, 'download_failed'), safeMessage(err));
+      return;
+    }
+    if (Number.isInteger(job.size_bytes) && bytes.length !== job.size_bytes) {
+      await report(jobRef, 'failed', 'file_changed', 'The file does not match what the customer uploaded.');
+      return;
+    }
+
+    const type = detectFileType(bytes);
+    if (!type) {
+      await report(jobRef, 'failed', 'file_type_unknown', 'The file is not a PDF, JPEG or PNG.');
+      return;
+    }
+
+    let toPrint = bytes;
+    let extension = type === 'jpeg' ? 'jpg' : type;
+    if (type !== 'pdf' && !adapter.acceptsImages) {
+      try {
+        toPrint = imageToPdf(bytes);
+        extension = 'pdf';
+      } catch (err) {
+        await report(jobRef, 'failed', codeOf(err, 'image_unsupported'), safeMessage(err));
+        return;
+      }
+    }
+
+    await mkdir(workDir, { recursive: true });
+    const dir = await mkdtemp(path.join(workDir, 'job-'));
+    try {
+      const filePath = path.join(dir, `job.${extension}`);
+      await writeFile(filePath, toPrint, { mode: 0o600 });
+
+      // Note first, so a crash between here and the printer is seen on restart.
+      await journal.setActive({ ...jobRef, state: 'starting', at: now() });
+      try {
+        await api.markPrinting(jobRef);
+      } catch (err) {
+        // Nothing has been sent to the printer. The server requeues the job when the lease ends,
+        // or it has already moved on. Do not report a failure: that would invite a reprint.
+        await journal.clearActive();
+        log(`${label}: not printed. The server did not confirm the start (${err.code ?? 'error'}).`);
+        return;
+      }
+
+      await journal.setActive({ ...jobRef, state: 'submitting', at: now() });
+      let result;
+      try {
+        result = await adapter.print({
+          printer: printer.name,
+          file: filePath,
+          copies: settings.copies,
+          colour: settings.colour,
+          duplex: settings.duplex,
+          paper: settings.paper,
+          title: `QRquick ${String(job.job_id).slice(0, 8)}`,
+          capabilities: printer,
+        });
+      } catch (err) {
+        await journal.clearActive();
+        log(`${label}: the printer did not accept the job (${err.code ?? 'error'}).`);
+        await report(jobRef, 'failed', codeOf(err, 'spooler_error'), safeMessage(err));
+        return;
+      }
+
+      await journal.setActive({ ...jobRef, state: 'submitted', at: now(), spoolerId: result?.spoolerId ?? null });
+      await report(jobRef, 'sent');
+      await journal.clearActive();
+      log(`${label}: sent to ${printer.name}.`);
+    } finally {
+      await rm(dir, { recursive: true, force: true });
+    }
+  }
+
+  // A restart after a crash. A job that was accepted by the printer system is reported as sent.
+  // A job that was only being prepared is cleared, because nothing was sent. A job whose state
+  // is unknown is left to the server, which asks the owner to check the printer.
+  async function recoverAfterRestart() {
+    const state = await journal.read();
+    const active = state.activeJob;
+    if (active) {
+      if (active.state === 'submitted') {
+        await journal.addReport({ jobId: active.jobId, attempt: active.attempt, outcome: 'sent' });
+      }
+      await journal.clearActive();
+    }
+  }
+
+  async function run({ signal } = {}) {
+    await recoverAfterRestart();
+    while (!signal?.aborted) {
+      try {
+        if (now() - lastHeartbeat >= heartbeatMs) await sendHeartbeat();
+        await flushReports();
+        const response = await api.claim();
+        failures = 0;
+        if (!response || !response.job) {
+          await sleep(pollMs);
+          continue;
+        }
+        await processJob(response.job);
+      } catch (err) {
+        if (err instanceof AgentRevokedError) throw err;
+        if (err instanceof AgentApiError && err.status === 401) throw new AgentRevokedError();
+        failures += 1;
+        log(`Problem talking to QRquick: ${safeMessage(err)} Trying again.`);
+        await sleep(Math.min(60000, 5000 * failures));
+      }
+    }
+  }
+
+  return { run, processJob, sendHeartbeat, flushReports, recoverAfterRestart };
+}
diff --git a/agent/test/cli.test.mjs b/agent/test/cli.test.mjs
new file mode 100644
index 0000000..f4342dc
--- /dev/null
+++ b/agent/test/cli.test.mjs
@@ -0,0 +1,108 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { loadConfig } from '../src/config.mjs';
+import { main } from '../src/cli.mjs';
+
+const TOKEN = 'qpa_' + 'K'.repeat(43);
+const SERVER = 'https://x.example.supabase.co/functions/v1/print-agent';
+
+async function setup(t, extra = {}) {
+  const dir = await mkdtemp(path.join(os.tmpdir(), 'qrq-cli-'));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  const out = [];
+  const fail = [];
+  const deps = { dir, platform: 'linux', out: (l) => out.push(l), fail: (l) => fail.push(l), ...extra };
+  return { dir, out, fail, deps };
+}
+
+const pairingFetch = (requests) => async (url, init) => {
+  requests.push({ url, body: JSON.parse(init.body) });
+  return new Response(JSON.stringify({ agent_id: 'agent-1', shop_name: 'Test Print Shop', token: TOKEN }), {
+    status: 200,
+    headers: { 'content-type': 'application/json' },
+  });
+};
+
+const oneOffice = {
+  platform: 'linux',
+  listPrinters: async () => [{ name: 'Office', isDefault: true, enabled: true, capabilitiesKnown: true, colour: false, duplex: false, papers: null }],
+  print: async () => ({ spoolerId: null }),
+};
+
+test('pair saves the token, prints no token, and sends the code to the server', async (t) => {
+  const requests = [];
+  const { dir, out, fail, deps } = await setup(t, { fetchImpl: pairingFetch(requests), computerName: 'SHOP-PC' });
+  const code = await main(['pair', SERVER, 'ABCD-EFGH'], deps);
+  assert.equal(code, 0, fail.join('\n'));
+  assert.equal(requests[0].url, `${SERVER}/pair`);
+  assert.deepEqual(requests[0].body, { code: 'ABCD-EFGH', name: 'SHOP-PC', platform: 'linux', version: '0.1.0' });
+  assert.ok(out.some((l) => l.includes('Paired with Test Print Shop')));
+  assert.ok(!out.join('\n').includes(TOKEN), 'the token is never printed');
+  const saved = await loadConfig(dir);
+  assert.equal(saved.token, TOKEN);
+  assert.equal(saved.serverUrl, SERVER);
+});
+
+test('pair refuses an insecure server address before contacting anything', async (t) => {
+  const requests = [];
+  const { fail, deps } = await setup(t, { fetchImpl: pairingFetch(requests) });
+  const code = await main(['pair', 'http://example.com/functions', 'ABCD-EFGH'], deps);
+  assert.equal(code, 1);
+  assert.equal(requests.length, 0);
+  assert.match(fail[0], /must start with https/);
+});
+
+test('set-printer only accepts a printer that exists on this computer', async (t) => {
+  const { dir, out, fail, deps } = await setup(t, { adapter: oneOffice, fetchImpl: pairingFetch([]) });
+  await main(['pair', SERVER, 'ABCD-EFGH'], deps);
+  assert.equal(await main(['set-printer', 'Nowhere'], deps), 1);
+  assert.match(fail.at(-1), /is not a printer on this computer/);
+  assert.equal(await main(['set-printer', 'Office'], deps), 0);
+  assert.equal((await loadConfig(dir)).printer, 'Office');
+  assert.ok(out.at(-1).includes('"Office" is now the fallback printer'));
+});
+
+test('run refuses to start before the computer is paired', async (t) => {
+  const { fail, deps } = await setup(t, { adapter: oneOffice });
+  assert.equal(await main(['run'], deps), 1);
+  assert.match(fail[0], /not paired yet/);
+});
+
+test('doctor reports a failed connection and exits non-zero', async (t) => {
+  const { out, deps } = await setup(t, {
+    adapter: oneOffice,
+    fetchImpl: pairingFetch([]),
+  });
+  await main(['pair', SERVER, 'ABCD-EFGH'], deps);
+  const failing = { ...deps, fetchImpl: async () => { throw new TypeError('offline'); } };
+  const out2 = [];
+  const code = await main(['doctor'], { ...failing, out: (l) => out2.push(l) });
+  assert.equal(code, 1);
+  assert.ok(out2.some((l) => l.startsWith('FAIL Connected to QRquick')));
+  assert.ok(out2.some((l) => l.startsWith('OK   Paired with QRquick')));
+  assert.ok(out.length > 0);
+});
+
+test('doctor sends the real printer list, so the owner keeps seeing the printers', async (t) => {
+  const { deps } = await setup(t, { adapter: oneOffice, fetchImpl: pairingFetch([]) });
+  await main(['pair', SERVER, 'ABCD-EFGH'], deps);
+  const bodies = [];
+  const fetchImpl = async (url, init) => {
+    bodies.push(JSON.parse(init.body));
+    return new Response(JSON.stringify({ ok: true }), { status: 200, headers: { 'content-type': 'application/json' } });
+  };
+  const code = await main(['doctor'], { ...deps, fetchImpl });
+  assert.equal(code, 0);
+  assert.equal(bodies[0].printers[0].name, 'Office');
+});
+
+test('unknown commands and help', async (t) => {
+  const { out, fail, deps } = await setup(t);
+  assert.equal(await main(['help'], deps), 0);
+  assert.ok(out.join('\n').includes('Commands:'));
+  assert.equal(await main(['frobnicate'], deps), 1);
+  assert.match(fail[0], /Unknown command "frobnicate"/);
+});
diff --git a/agent/test/image-to-pdf.test.mjs b/agent/test/image-to-pdf.test.mjs
new file mode 100644
index 0000000..70a4b4b
--- /dev/null
+++ b/agent/test/image-to-pdf.test.mjs
@@ -0,0 +1,117 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { deflateSync } from 'node:zlib';
+import { imageToPdf, readImage, UnsupportedImageError } from '../src/image-to-pdf.mjs';
+import { detectFileType } from '../src/file-check.mjs';
+
+function pngChunk(type, data) {
+  const length = Buffer.alloc(4);
+  length.writeUInt32BE(data.length);
+  // The reader does not check CRCs, so four zero bytes stand in for the checksum.
+  return Buffer.concat([length, Buffer.from(type, 'latin1'), data, Buffer.alloc(4)]);
+}
+
+function tinyPng({ width = 2, height = 3, colorType = 2, bitDepth = 8, transparent = false } = {}) {
+  const channels = colorType === 2 ? 3 : 1;
+  const ihdr = Buffer.alloc(13);
+  ihdr.writeUInt32BE(width, 0);
+  ihdr.writeUInt32BE(height, 4);
+  ihdr[8] = bitDepth;
+  ihdr[9] = colorType;
+  const rows = [];
+  for (let y = 0; y < height; y++) {
+    rows.push(Buffer.concat([Buffer.from([0]), Buffer.alloc(width * channels, 0x80)]));
+  }
+  return Buffer.concat([
+    Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+    pngChunk('IHDR', ihdr),
+    ...(transparent ? [pngChunk('tRNS', Buffer.from([0, 0]))] : []),
+    pngChunk('IDAT', deflateSync(Buffer.concat(rows))),
+    pngChunk('IEND', Buffer.alloc(0)),
+  ]);
+}
+
+// Only the start-of-frame segment is real. That is all the reader needs.
+function jpeg({ width = 8, height = 8, components = 1 } = {}) {
+  const length = 8 + 3 * components;
+  const sof = Buffer.alloc(length + 2);
+  sof[0] = 0xff;
+  sof[1] = 0xc0;
+  sof.writeUInt16BE(length, 2);
+  sof[4] = 8;
+  sof.writeUInt16BE(height, 5);
+  sof.writeUInt16BE(width, 7);
+  sof[9] = components;
+  for (let i = 0; i < components; i++) {
+    sof[10 + i * 3] = i + 1;
+    sof[11 + i * 3] = 0x11;
+    sof[12 + i * 3] = 0;
+  }
+  return Buffer.concat([Buffer.from([0xff, 0xd8]), sof, Buffer.from([0xff, 0xd9])]);
+}
+
+// Checks that every cross-reference offset points at the object it names.
+function checkXref(pdf) {
+  const text = pdf.toString('latin1');
+  const match = /startxref\n(\d+)\n%%EOF\n$/.exec(text);
+  assert.ok(match, 'PDF ends with startxref and %%EOF');
+  const start = Number(match[1]);
+  assert.equal(text.slice(start, start + 4), 'xref');
+  const lines = text.slice(start).split('\n');
+  const count = Number(lines[1].split(' ')[1]);
+  for (let n = 1; n < count; n++) {
+    const offset = parseInt(lines[2 + n].slice(0, 10), 10);
+    assert.ok(text.slice(offset).startsWith(`${n} 0 obj`), `object ${n} is at offset ${offset}`);
+  }
+}
+
+test('detects PDF, JPEG and PNG by their first bytes, not by file name', () => {
+  assert.equal(detectFileType(Buffer.from('%PDF-1.7\n')), 'pdf');
+  assert.equal(detectFileType(jpeg()), 'jpeg');
+  assert.equal(detectFileType(tinyPng()), 'png');
+  assert.equal(detectFileType(Buffer.from('GIF89a')), null);
+  assert.equal(detectFileType(Buffer.alloc(0)), null);
+});
+
+test('wraps an RGB PNG in a valid one-page PDF with the picture as a Flate stream', () => {
+  const pdf = imageToPdf(tinyPng());
+  const text = pdf.toString('latin1');
+  assert.ok(text.startsWith('%PDF-1.4'));
+  assert.match(text, /\/DeviceRGB/);
+  assert.match(text, /\/FlateDecode/);
+  assert.match(text, /\/Predictor 15 \/Colors 3/);
+  assert.match(text, /\/Count 1/);
+  checkXref(pdf);
+});
+
+test('wraps a greyscale PNG with DeviceGray', () => {
+  const pdf = imageToPdf(tinyPng({ colorType: 0 }));
+  assert.match(pdf.toString('latin1'), /\/DeviceGray/);
+  assert.match(pdf.toString('latin1'), /\/Predictor 15 \/Colors 1/);
+  checkXref(pdf);
+});
+
+test('wraps a JPEG without re-encoding it (DCTDecode)', () => {
+  const pdf = imageToPdf(jpeg({ width: 300, height: 200 }));
+  assert.match(pdf.toString('latin1'), /\/DCTDecode/);
+  checkXref(pdf);
+});
+
+test('refuses PNG pictures with transparency, alpha or 16-bit depth', () => {
+  assert.throws(() => imageToPdf(tinyPng({ transparent: true })), /transparency/);
+  assert.throws(() => imageToPdf(tinyPng({ colorType: 6 })), UnsupportedImageError);
+  assert.throws(() => imageToPdf(tinyPng({ bitDepth: 16 })), /8-bit PNG/);
+});
+
+test('refuses CMYK JPEG and other colour formats with a clear message', () => {
+  assert.throws(() => imageToPdf(jpeg({ components: 4 })), /JPEG colour format cannot be printed/);
+  try {
+    imageToPdf(jpeg({ components: 4 }));
+  } catch (err) {
+    assert.equal(err.code, 'image_unsupported');
+  }
+});
+
+test('readImage rejects anything that is not a JPEG or PNG', () => {
+  assert.throws(() => readImage(Buffer.from('GIF89a........', 'latin1')), /not a JPEG or PNG/);
+});
diff --git a/agent/test/printers.test.mjs b/agent/test/printers.test.mjs
new file mode 100644
index 0000000..b7c9eaa
--- /dev/null
+++ b/agent/test/printers.test.mjs
@@ -0,0 +1,222 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  buildLpArgs,
+  capabilitiesFromOptions,
+  createLinuxAdapter,
+  parseDefaultPrinter,
+  parseOptionList,
+  parsePrinterList,
+} from '../src/printers/linux.mjs';
+import {
+  buildSumatraArgs,
+  createWindowsAdapter,
+  findSumatra,
+  parseWindowsPrinters,
+  parseWindowsPrintConfig,
+  sumatraSettings,
+} from '../src/printers/windows.mjs';
+
+const ok = (stdout = '') => ({ code: 0, stdout, stderr: '', timedOut: false });
+
+// Routes a fake command by its first words. Anything not listed behaves as "not installed".
+function fakeRun(table) {
+  return async (file, args) => {
+    const key = [file, ...args].join(' ');
+    for (const [prefix, result] of Object.entries(table)) {
+      if (key === prefix || key.startsWith(`${prefix} `)) {
+        return typeof result === 'function' ? result(args) : result;
+      }
+    }
+    throw Object.assign(new Error(`${file} not found`), { code: 'ENOENT' });
+  };
+}
+
+// ---- Linux (CUPS) -------------------------------------------------------------
+
+test('reads the CUPS printer list, enabled state and default', () => {
+  const list = parsePrinterList('printer Office is idle.  enabled since Mon\nprinter Back disabled since Tue -\n');
+  assert.deepEqual(list, [
+    { name: 'Office', enabled: true },
+    { name: 'Back', enabled: false },
+  ]);
+  assert.equal(parseDefaultPrinter('system default destination: Office\n'), 'Office');
+  assert.equal(parseDefaultPrinter('no default\n'), null);
+});
+
+test('reads printer options, marking the default value with an asterisk', () => {
+  const options = parseOptionList([
+    'ColorModel/Color Model: *Gray RGB',
+    'Duplex/Double-Sided Printing: *None DuplexNoTumble DuplexTumble',
+    'PageSize/Media Size: *A4 Letter Legal',
+  ].join('\n'));
+  assert.deepEqual(options.ColorModel, ['Gray', 'RGB']);
+  assert.deepEqual(options.Duplex, ['None', 'DuplexNoTumble', 'DuplexTumble']);
+  assert.deepEqual(options.PageSize, ['A4', 'Letter', 'Legal']);
+});
+
+test('colour and double-sided come only from the printer\'s own options', () => {
+  const colour = capabilitiesFromOptions({ ColorModel: ['Gray', 'RGB'], Duplex: ['None', 'DuplexNoTumble'] });
+  assert.equal(colour.capabilitiesKnown, true);
+  assert.equal(colour.colour, true);
+  assert.equal(colour.duplex, true);
+
+  const mono = capabilitiesFromOptions({ ColorModel: ['Gray'] });
+  assert.equal(mono.colour, false);
+  assert.equal(mono.duplex, false);
+
+  assert.equal(capabilitiesFromOptions({}).capabilitiesKnown, false);
+});
+
+test('an IPP "one-sided" value is NOT read as double-sided', () => {
+  assert.equal(capabilitiesFromOptions({ sides: ['one-sided'] }).duplex, false);
+  assert.equal(capabilitiesFromOptions({ sides: ['one-sided', 'two-sided-long-edge'] }).duplex, true);
+});
+
+test('lp arguments: printer, copies, colour, duplex, media, then "--" before the file', () => {
+  const capabilities = { papers: ['A4', 'Letter'], colourModes: ['Gray', 'RGB'] };
+  const args = buildLpArgs({
+    printer: 'Office', file: '/tmp/x.pdf', copies: 3, colour: true, duplex: true,
+    paper: 'A4', title: 'QRquick job', capabilities,
+  });
+  assert.deepEqual(args, [
+    '-d', 'Office', '-n', '3', '-t', 'QRquick job',
+    '-o', 'media=A4',
+    '-o', 'ColorModel=RGB',
+    '-o', 'sides=two-sided-long-edge',
+    '--', '/tmp/x.pdf',
+  ]);
+});
+
+test('lp arguments leave out media the printer does not list, and pick a grey mode for black-and-white', () => {
+  const args = buildLpArgs({
+    printer: 'Office', file: 'f.pdf', copies: 1, colour: false, duplex: false,
+    paper: 'A3', title: 't', capabilities: { papers: ['A4'], colourModes: ['Gray', 'RGB'] },
+  });
+  assert.ok(!args.some((a) => a.startsWith('media=')));
+  assert.ok(args.includes('ColorModel=Gray'));
+  assert.equal(args.at(-1), 'f.pdf');
+  assert.equal(args.at(-2), '--');
+});
+
+test('Linux adapter lists printers with default and capability flags', async () => {
+  const run = fakeRun({
+    lpstat: (args) => (args[0] === '-p'
+      ? ok('printer Office is idle.  enabled since Mon\nprinter Back disabled since Tue -\n')
+      : ok('system default destination: Office\n')),
+    lpoptions: (args) => (args[1] === 'Office'
+      ? ok('ColorModel/Color Model: *Gray RGB\nDuplex/Double-Sided: *None DuplexNoTumble\n')
+      : ok('')),
+  });
+  const printers = await createLinuxAdapter({ run }).listPrinters();
+  assert.equal(printers[0].name, 'Office');
+  assert.equal(printers[0].isDefault, true);
+  assert.equal(printers[0].colour, true);
+  assert.equal(printers[0].duplex, true);
+  assert.equal(printers[1].enabled, false);
+  assert.equal(printers[1].capabilitiesKnown, false);
+});
+
+test('Linux adapter reports a missing CUPS as print_engine_missing', async () => {
+  const adapter = createLinuxAdapter({ run: fakeRun({}) });
+  await assert.rejects(adapter.listPrinters(), (err) => err.code === 'print_engine_missing');
+});
+
+test('Linux adapter submits with lp and returns the request id', async () => {
+  const run = fakeRun({ lp: () => ok('request id is Office-42 (1 file(s))\n') });
+  const result = await createLinuxAdapter({ run }).print({
+    printer: 'Office', file: '/tmp/a.pdf', copies: 1, colour: false, duplex: false,
+    paper: 'A4', title: 't', capabilities: { papers: null, colourModes: [] },
+  });
+  assert.equal(result.spoolerId, 'Office-42');
+});
+
+test('Linux adapter turns an lp refusal into spooler_error', async () => {
+  const run = fakeRun({ lp: () => ({ code: 1, stdout: '', stderr: 'lp: Printer is not accepting jobs', timedOut: false }) });
+  await assert.rejects(
+    createLinuxAdapter({ run }).print({
+      printer: 'Office', file: '/tmp/a.pdf', copies: 1, colour: false, duplex: false,
+      paper: 'A4', title: 't', capabilities: { papers: null, colourModes: [] },
+    }),
+    (err) => err.code === 'spooler_error',
+  );
+});
+
+// ---- Windows (PowerShell + SumatraPDF) ---------------------------------------
+
+test('reads Windows printer lists whether PowerShell returns one object or many', () => {
+  assert.deepEqual(parseWindowsPrinters(''), []);
+  assert.deepEqual(parseWindowsPrinters('{"Name":"Office","Default":true,"WorkOffline":false}'), [
+    { name: 'Office', isDefault: true, enabled: true },
+  ]);
+  assert.equal(parseWindowsPrinters('[{"Name":"A","Default":false,"WorkOffline":true}]')[0].enabled, false);
+});
+
+test('reads colour and duplex from the print configuration, and says "unknown" when absent', () => {
+  assert.deepEqual(parseWindowsPrintConfig('{"Color":true,"DuplexingMode":"TwoSidedLongEdge"}'), {
+    colour: true,
+    duplex: true,
+  });
+  assert.deepEqual(parseWindowsPrintConfig('{"Color":false,"DuplexingMode":"OneSided"}'), {
+    colour: false,
+    duplex: false,
+  });
+  assert.deepEqual(parseWindowsPrintConfig('{"DuplexingMode":"Unknown"}'), { colour: null, duplex: null });
+  assert.equal(parseWindowsPrintConfig(''), null);
+});
+
+test('SumatraPDF settings: copies, colour mode and duplex', () => {
+  assert.equal(sumatraSettings({ copies: 3, colour: false, duplex: true }), '3x,monochrome,duplexlong');
+  assert.equal(sumatraSettings({ copies: 1, colour: true, duplex: false }), '1x,color');
+});
+
+test('SumatraPDF arguments keep the printer name as one argument (no shell parsing)', () => {
+  const args = buildSumatraArgs({
+    printer: 'HP Office & Co "2nd"', file: 'C:\\temp\\job.pdf', copies: 1, colour: false, duplex: false,
+  });
+  assert.equal(args[0], '-print-to');
+  assert.equal(args[1], 'HP Office & Co "2nd"');
+  assert.ok(args.includes('-exit-on-print'));
+  assert.equal(args.at(-1), 'C:\\temp\\job.pdf');
+});
+
+test('finds SumatraPDF in the usual install folders only', () => {
+  assert.ok(findSumatra({ ProgramFiles: 'C:\\PF' }, (p) => p.startsWith('C:\\PF')).endsWith('SumatraPDF.exe'));
+  assert.equal(findSumatra({}, () => false), null);
+});
+
+test('Windows adapter prints with SumatraPDF and reports a missing install clearly', async () => {
+  const missing = createWindowsAdapter({ run: fakeRun({}), sumatraPath: null });
+  await assert.rejects(
+    missing.print({ printer: 'Office', file: 'x.pdf', copies: 1, colour: false, duplex: false }),
+    (err) => err.code === 'print_engine_missing' && /SumatraPDF is not set up/.test(err.message),
+  );
+
+  const calls = [];
+  const run = async (file, args) => {
+    calls.push([file, args]);
+    return ok();
+  };
+  await createWindowsAdapter({ run, sumatraPath: 'C:\\SumatraPDF.exe' }).print({
+    printer: 'Office', file: 'x.pdf', copies: 2, colour: false, duplex: true,
+  });
+  assert.equal(calls[0][0], 'C:\\SumatraPDF.exe');
+  assert.ok(calls[0][1].includes('2x,monochrome,duplexlong'));
+});
+
+test('Windows adapter reads printers through PowerShell and passes the name as an environment value', async () => {
+  const seenEnv = [];
+  const run = async (file, args, options = {}) => {
+    if (args.at(-1).includes('Win32_Printer')) {
+      return ok('{"Name":"Office","Default":true,"WorkOffline":false}');
+    }
+    seenEnv.push(options.env?.QRQUICK_PRINTER);
+    return ok('{"Color":false,"DuplexingMode":"TwoSidedLongEdge"}');
+  };
+  const printers = await createWindowsAdapter({ run }).listPrinters();
+  assert.equal(printers[0].name, 'Office');
+  assert.equal(printers[0].capabilitiesKnown, true);
+  assert.equal(printers[0].colour, false);
+  assert.equal(printers[0].duplex, true);
+  assert.deepEqual(seenEnv, ['Office']);
+});
diff --git a/agent/test/support.test.mjs b/agent/test/support.test.mjs
