new file mode 100644
index 0000000..75efa19
--- /dev/null
+++ b/agent/src/config.mjs
@@ -0,0 +1,65 @@
+// What the agent keeps on this computer: the server address, the agent's token,
+// the printer to use and the computer's name. The token is a secret. The file is
+// written with owner-only permissions where the system supports them.
+
+import { mkdir, readFile, rename, writeFile, chmod } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+export function defaultConfigDir(platform = process.platform, env = process.env) {
+  if (env.QRQUICK_AGENT_DIR) return env.QRQUICK_AGENT_DIR;
+  if (platform === 'win32') {
+    const appData = env.APPDATA || path.join(os.homedir(), 'AppData', 'Roaming');
+    return path.join(appData, 'QRquick Print Agent');
+  }
+  return path.join(env.XDG_CONFIG_HOME || path.join(os.homedir(), '.config'), 'qrquick-print-agent');
+}
+
+export function configPaths(dir) {
+  return {
+    dir,
+    config: path.join(dir, 'agent.json'),
+    outbox: path.join(dir, 'outbox.json'),
+  };
+}
+
+// The address of the print-agent function. Only https is accepted, except for a
+// test server on this same computer.
+export function normaliseServerUrl(input) {
+  let url;
+  try {
+    url = new URL(String(input ?? '').trim());
+  } catch {
+    throw new Error('The server address is not a valid web address.');
+  }
+  const local = url.hostname === 'localhost' || url.hostname === '127.0.0.1';
+  if (url.protocol !== 'https:' && !(url.protocol === 'http:' && local)) {
+    throw new Error('The server address must start with https://');
+  }
+  url.hash = '';
+  url.search = '';
+  return url.toString().replace(/\/$/, '');
+}
+
+export async function loadConfig(dir) {
+  try {
+    const parsed = JSON.parse(await readFile(configPaths(dir).config, 'utf8'));
+    return parsed && typeof parsed === 'object' ? parsed : null;
+  } catch (err) {
+    if (err.code === 'ENOENT') return null;
+    throw err;
+  }
+}
+
+export async function saveConfig(dir, config) {
+  const { config: file } = configPaths(dir);
+  await mkdir(dir, { recursive: true });
+  const temp = `${file}.tmp`;
+  await writeFile(temp, `${JSON.stringify(config, null, 2)}\n`, { mode: 0o600 });
+  await rename(temp, file);
+  try {
+    await chmod(file, 0o600);
+  } catch {
+    // Windows ignores POSIX modes. The folder is already private to the user.
+  }
+}
diff --git a/agent/src/file-check.mjs b/agent/src/file-check.mjs
new file mode 100644
index 0000000..703afc8
--- /dev/null
+++ b/agent/src/file-check.mjs
@@ -0,0 +1,13 @@
+// Looks at the first bytes of a file to decide what it really is. The file name and
+// the upload type are not trusted.
+
+export const MAX_FILE_BYTES = 10 * 1024 * 1024;
+
+const PNG_SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+
+export function detectFileType(buf) {
+  if (buf.length >= 5 && buf.toString('latin1', 0, 5) === '%PDF-') return 'pdf';
+  if (buf.length >= 3 && buf[0] === 0xff && buf[1] === 0xd8 && buf[2] === 0xff) return 'jpeg';
+  if (buf.length >= 8 && buf.subarray(0, 8).equals(PNG_SIGNATURE)) return 'png';
+  return null;
+}
diff --git a/agent/src/image-to-pdf.mjs b/agent/src/image-to-pdf.mjs
new file mode 100644
index 0000000..2e84b72
--- /dev/null
+++ b/agent/src/image-to-pdf.mjs
@@ -0,0 +1,181 @@
+// Wraps a JPEG or PNG picture in a one-page A4 PDF, so the Windows path can print
+// photos through SumatraPDF. Pure JavaScript, no dependencies.
+//
+// JPEG data is embedded unchanged (DCTDecode). PNG data is embedded as its own
+// compressed stream with the PNG row filters kept (FlateDecode with Predictor 15).
+// Only 8-bit greyscale and RGB pictures are accepted. Pictures with transparency or
+// a palette are refused, so the agent never prints a surprising result.
+
+import { Buffer } from 'node:buffer';
+
+const A4_WIDTH = 595.28;
+const A4_HEIGHT = 841.89;
+const MARGIN = 36;
+const PNG_SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+
+export class UnsupportedImageError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'UnsupportedImageError';
+    this.code = 'image_unsupported';
+  }
+}
+
+export function readJpeg(buf) {
+  let i = 2;
+  while (i + 4 <= buf.length) {
+    if (buf[i] !== 0xff) {
+      i++;
+      continue;
+    }
+    const marker = buf[i + 1];
+    if (marker === 0xff) {
+      i++;
+      continue;
+    }
+    if (marker === 0xd8 || marker === 0x01 || (marker >= 0xd0 && marker <= 0xd7)) {
+      i += 2;
+      continue;
+    }
+    if (marker === 0xd9 || marker === 0xda) break; // end of image or start of scan: no frame found
+    const length = buf.readUInt16BE(i + 2);
+    const isFrame = marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc;
+    if (isFrame) {
+      if (i + 10 > buf.length) break;
+      const precision = buf[i + 4];
+      const height = buf.readUInt16BE(i + 5);
+      const width = buf.readUInt16BE(i + 7);
+      const components = buf[i + 9];
+      if (precision !== 8 || (components !== 1 && components !== 3) || width < 1 || height < 1) {
+        throw new UnsupportedImageError(
+          'This JPEG colour format cannot be printed here. Save the picture again as a standard colour or grey JPG.',
+        );
+      }
+      return { kind: 'jpeg', width, height, components, data: buf };
+    }
+    i += 2 + length;
+  }
+  throw new UnsupportedImageError('The JPEG picture could not be read.');
+}
+
+export function readPng(buf) {
+  let offset = 8;
+  let header = null;
+  let hasTransparency = false;
+  const pixels = [];
+  while (offset + 8 <= buf.length) {
+    const length = buf.readUInt32BE(offset);
+    const type = buf.toString('latin1', offset + 4, offset + 8);
+    const start = offset + 8;
+    const end = start + length;
+    if (end + 4 > buf.length) break;
+    const chunk = buf.subarray(start, end);
+    if (type === 'IHDR') {
+      header = {
+        width: chunk.readUInt32BE(0),
+        height: chunk.readUInt32BE(4),
+        bitDepth: chunk[8],
+        colorType: chunk[9],
+        interlace: chunk[12],
+      };
+    } else if (type === 'IDAT') {
+      pixels.push(chunk);
+    } else if (type === 'tRNS') {
+      hasTransparency = true;
+    } else if (type === 'IEND') {
+      break;
+    }
+    offset = end + 4;
+  }
+  if (!header || pixels.length === 0) {
+    throw new UnsupportedImageError('The PNG picture could not be read.');
+  }
+  if (header.bitDepth !== 8 || header.interlace !== 0 || (header.colorType !== 0 && header.colorType !== 2)) {
+    throw new UnsupportedImageError(
+      'Only 8-bit PNG pictures without transparency can be printed on this computer. Save the picture as JPG and try again.',
+    );
+  }
+  if (hasTransparency || header.width < 1 || header.height < 1) {
+    throw new UnsupportedImageError(
+      'PNG pictures with transparency cannot be printed on this computer. Save the picture as JPG and try again.',
+    );
+  }
+  return {
+    kind: 'png',
+    width: header.width,
+    height: header.height,
+    components: header.colorType === 2 ? 3 : 1,
+    data: Buffer.concat(pixels),
+  };
+}
+
+export function readImage(buf) {
+  if (buf.length >= 2 && buf[0] === 0xff && buf[1] === 0xd8) return readJpeg(buf);
+  if (buf.length >= 8 && buf.subarray(0, 8).equals(PNG_SIGNATURE)) return readPng(buf);
+  throw new UnsupportedImageError('The picture is not a JPEG or PNG file.');
+}
+
+function fmt(value) {
+  return Number(value.toFixed(2));
+}
+
+// Returns a complete PDF file (as a Buffer) that shows the picture centred on one A4 page.
+export function imageToPdf(buf) {
+  const image = readImage(buf);
+  const colorSpace = image.components === 1 ? '/DeviceGray' : '/DeviceRGB';
+  const scale = Math.min(
+    (A4_WIDTH - 2 * MARGIN) / image.width,
+    (A4_HEIGHT - 2 * MARGIN) / image.height,
+  );
+  const drawWidth = image.width * scale;
+  const drawHeight = image.height * scale;
+  const x = (A4_WIDTH - drawWidth) / 2;
+  const y = (A4_HEIGHT - drawHeight) / 2;
+
+  const content = Buffer.from(
+    `q ${fmt(drawWidth)} 0 0 ${fmt(drawHeight)} ${fmt(x)} ${fmt(y)} cm /Im0 Do Q\n`,
+    'latin1',
+  );
+
+  const base = `/Type /XObject /Subtype /Image /Width ${image.width} /Height ${image.height}` +
+    ` /ColorSpace ${colorSpace} /BitsPerComponent 8`;
+  const imageDict = image.kind === 'jpeg'
+    ? `<< ${base} /Filter /DCTDecode /Length ${image.data.length} >>`
+    : `<< ${base} /Filter /FlateDecode /DecodeParms << /Predictor 15 /Colors ${image.components}` +
+      ` /BitsPerComponent 8 /Columns ${image.width} >> /Length ${image.data.length} >>`;
+
+  const chunks = [];
+  const offsets = [];
+  let length = 0;
+  const push = (part) => {
+    chunks.push(part);
+    length += part.length;
+  };
+  const addObject = (number, parts) => {
+    offsets[number] = length;
+    push(Buffer.from(`${number} 0 obj\n`, 'latin1'));
+    for (const part of parts) push(Buffer.isBuffer(part) ? part : Buffer.from(part, 'latin1'));
+    push(Buffer.from('\nendobj\n', 'latin1'));
+  };
+
+  push(Buffer.from('%PDF-1.4\n%\xe2\xe3\xcf\xd3\n', 'latin1'));
+  addObject(1, ['<< /Type /Catalog /Pages 2 0 R >>']);
+  addObject(2, ['<< /Type /Pages /Kids [3 0 R] /Count 1 >>']);
+  addObject(3, [
+    `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${A4_WIDTH} ${A4_HEIGHT}]` +
+      ' /Resources << /XObject << /Im0 5 0 R >> >> /Contents 4 0 R >>',
+  ]);
+  addObject(4, [`<< /Length ${content.length} >>\nstream\n`, content, '\nendstream']);
+  addObject(5, [`${imageDict}\nstream\n`, image.data, '\nendstream']);
+
+  const xrefOffset = length;
+  let xref = 'xref\n0 6\n0000000000 65535 f \n';
+  for (let n = 1; n <= 5; n++) {
+    xref += `${String(offsets[n]).padStart(10, '0')} 00000 n \n`;
+  }
+  push(Buffer.from(
+    `${xref}trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF\n`,
+    'latin1',
+  ));
+  return Buffer.concat(chunks);
+}
diff --git a/agent/src/journal.mjs b/agent/src/journal.mjs
new file mode 100644
index 0000000..bb67085
--- /dev/null
+++ b/agent/src/journal.mjs
@@ -0,0 +1,61 @@
+// The agent's own notes on disk. It records the job it is about to send to the
+// printer, and reports the server has not yet received. The note is written before
+// a file goes to the printer, so a crash or power cut cannot make the agent forget a
+// job that may have been printed.
+
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export function createJournal(file) {
+  async function read() {
+    let text;
+    try {
+      text = await readFile(file, 'utf8');
+    } catch (err) {
+      if (err.code === 'ENOENT') return { activeJob: null, pendingReports: [] };
+      throw err;
+    }
+    let data;
+    try {
+      data = JSON.parse(text);
+    } catch {
+      // Guessing could mean printing again, so stop and ask instead.
+      throw new Error(`The agent's notes file is damaged (${file}). Keep it, then ask for help before printing again.`);
+    }
+    return {
+      activeJob: data.activeJob ?? null,
+      pendingReports: Array.isArray(data.pendingReports) ? data.pendingReports : [],
+    };
+  }
+
+  async function write(data) {
+    await mkdir(path.dirname(file), { recursive: true });
+    const temp = `${file}.tmp`;
+    await writeFile(temp, `${JSON.stringify(data, null, 2)}\n`);
+    await rename(temp, file);
+  }
+
+  return {
+    read,
+    async setActive(job) {
+      const data = await read();
+      data.activeJob = job;
+      await write(data);
+    },
+    async clearActive() {
+      const data = await read();
+      data.activeJob = null;
+      await write(data);
+    },
+    async addReport(report) {
+      const data = await read();
+      data.pendingReports.push(report);
+      await write(data);
+    },
+    async removeReport(jobId, attempt) {
+      const data = await read();
+      data.pendingReports = data.pendingReports.filter((r) => !(r.jobId === jobId && r.attempt === attempt));
+      await write(data);
+    },
+  };
+}
diff --git a/agent/src/printers/index.mjs b/agent/src/printers/index.mjs
new file mode 100644
index 0000000..c16cb24
--- /dev/null
+++ b/agent/src/printers/index.mjs
@@ -0,0 +1,10 @@
+import { createLinuxAdapter } from './linux.mjs';
+import { createWindowsAdapter } from './windows.mjs';
+
+// Picks the printing support for this computer. Each adapter has the same shape:
+//   platform, acceptsImages, listPrinters(), print({...})
+export function createPrinterAdapter({ platform = process.platform, run, sumatraPath = null } = {}) {
+  if (platform === 'win32') return createWindowsAdapter({ run, sumatraPath });
+  if (platform === 'linux') return createLinuxAdapter({ run });
+  throw new Error('The QRquick print agent runs on Windows and Linux only.');
+}
diff --git a/agent/src/printers/linux.mjs b/agent/src/printers/linux.mjs
new file mode 100644
index 0000000..9f2c828
--- /dev/null
+++ b/agent/src/printers/linux.mjs
@@ -0,0 +1,127 @@
+// Printing on Linux through CUPS, using the standard lpstat, lpoptions and lp commands.
+// CUPS converts JPEG and PNG itself, so pictures are sent as they are.
+
+import { runCommand } from '../runner.mjs';
+
+const COLOUR_MODES = ['RGB', 'CMYK', 'Color', 'AdobeRGB'];
+const GREY_MODES = ['Gray', 'Grey', 'Black'];
+
+// "printer HP_LaserJet is idle.  enabled since ..."  ->  { name, enabled }
+export function parsePrinterList(output) {
+  const printers = [];
+  for (const line of String(output).split('\n')) {
+    const match = /^printer\s+(\S+)\s*(.*)$/.exec(line.trim());
+    if (match) printers.push({ name: match[1], enabled: !/disabled/i.test(match[2]) });
+  }
+  return printers;
+}
+
+// "system default destination: HP_LaserJet"  ->  "HP_LaserJet"
+export function parseDefaultPrinter(output) {
+  return /system default destination:\s*(\S+)/.exec(String(output))?.[1] ?? null;
+}
+
+// lpoptions -l prints one line per option:  "ColorModel/Color Model: *Gray RGB"
+// The asterisk marks the default value.
+export function parseOptionList(output) {
+  const options = {};
+  for (const line of String(output).split('\n')) {
+    const match = /^([A-Za-z0-9_-]+)\/[^:]*:\s*(.*)$/.exec(line.trim());
+    if (!match) continue;
+    options[match[1]] = match[2]
+      .split(/\s+/)
+      .map((value) => value.replace(/^\*/, ''))
+      .filter(Boolean);
+  }
+  return options;
+}
+
+// Only what the printer's own options say. A feature that cannot be found is treated
+// as not available, so an order is never sent with an option the printer may ignore.
+export function capabilitiesFromOptions(options) {
+  const known = Object.keys(options).length > 0;
+  const colourModes = options.ColorModel ?? options.ColourModel ?? options.ColorMode ?? [];
+  // PPD printers list "Duplex" (None, DuplexNoTumble, DuplexTumble); IPP printers list "sides"
+  // (one-sided, two-sided-long-edge, ...). Only the two-sided values count as duplex.
+  const duplexModes = options.Duplex ?? options.sides ?? [];
+  return {
+    capabilitiesKnown: known,
+    colour: colourModes.some((mode) => COLOUR_MODES.includes(mode)),
+    duplex: duplexModes.some((mode) => /two-sided|^Duplex/i.test(mode)),
+    papers: options.PageSize ?? null,
+    colourModes,
+    duplexModes,
+  };
+}
+
+// Builds the lp arguments. The file name always comes last, after "--".
+export function buildLpArgs({ printer, file, copies, colour, duplex, paper, title, capabilities }) {
+  const args = ['-d', printer, '-n', String(copies), '-t', title];
+  if (paper && capabilities.papers) {
+    const match = capabilities.papers.find((p) => p.toLowerCase() === String(paper).toLowerCase());
+    if (match) args.push('-o', `media=${match}`);
+  }
+  const modes = colour ? COLOUR_MODES : GREY_MODES;
+  const mode = modes.find((candidate) => capabilities.colourModes.includes(candidate));
+  if (mode) args.push('-o', `ColorModel=${mode}`);
+  if (duplex) args.push('-o', 'sides=two-sided-long-edge');
+  args.push('--', file);
+  return args;
+}
+
+function engineMissing(message) {
+  const err = new Error(message);
+  err.code = 'print_engine_missing';
+  return err;
+}
+
+export function createLinuxAdapter({ run = runCommand, cacheMs = 60000, now = () => Date.now() } = {}) {
+  let cache = null;
+
+  return {
+    platform: 'linux',
+    acceptsImages: true,
+
+    async listPrinters() {
+      if (cache && now() - cache.at < cacheMs) return cache.printers;
+      let listed;
+      let defaultName = null;
+      try {
+        listed = await run('lpstat', ['-p']);
+        defaultName = parseDefaultPrinter((await run('lpstat', ['-d'])).stdout);
+      } catch (err) {
+        if (err.code === 'ENOENT') throw engineMissing('CUPS is not installed on this computer (lpstat is missing).');
+        throw err;
+      }
+      const printers = [];
+      for (const printer of parsePrinterList(listed.stdout)) {
+        const options = await run('lpoptions', ['-p', printer.name, '-l']);
+        printers.push({
+          name: printer.name,
+          enabled: printer.enabled,
+          isDefault: printer.name === defaultName,
+          ...capabilitiesFromOptions(parseOptionList(options.stdout)),
+        });
+      }
+      cache = { at: now(), printers };
+      return printers;
+    },
+
+    async print({ printer, file, copies, colour, duplex, paper, title, capabilities }) {
+      const args = buildLpArgs({ printer, file, copies, colour, duplex, paper, title, capabilities });
+      let result;
+      try {
+        result = await run('lp', args, { timeoutMs: 120000 });
+      } catch (err) {
+        if (err.code === 'ENOENT') throw engineMissing('CUPS is not installed on this computer (lp is missing).');
+        throw err;
+      }
+      if (result.code !== 0) {
+        const error = new Error(result.stderr.trim().slice(0, 200) || 'CUPS did not accept the job.');
+        error.code = 'spooler_error';
+        throw error;
+      }
+      return { spoolerId: /request id is (\S+)/.exec(result.stdout)?.[1] ?? null };
+    },
+  };
+}
diff --git a/agent/src/printers/windows.mjs b/agent/src/printers/windows.mjs
new file mode 100644
index 0000000..3e72825
--- /dev/null
+++ b/agent/src/printers/windows.mjs
@@ -0,0 +1,121 @@
+// Printing on Windows through SumatraPDF, a free PDF viewer that can print silently
+// from the command line. The agent does not install it; the README explains how.
+// Printer discovery and colour/duplex detection use standard PowerShell cmdlets.
+//
+// Not yet tested on a real Windows computer. The SumatraPDF setting words are the
+// ones its documentation lists; check them on the installed version before relying on them.
+
+import { existsSync } from 'node:fs';
+import path from 'node:path';
+import { runCommand } from '../runner.mjs';
+
+const LIST_SCRIPT =
+  'Get-CimInstance -ClassName Win32_Printer | Select-Object Name, Default, WorkOffline | ConvertTo-Json -Compress';
+// The printer name comes from the environment, never from the script text.
+const CONFIG_SCRIPT =
+  'Get-PrintConfiguration -PrinterName $env:QRQUICK_PRINTER | Select-Object Color, DuplexingMode | ConvertTo-Json -Compress';
+
+export function parseWindowsPrinters(json) {
+  if (!json || !json.trim()) return [];
+  const data = JSON.parse(json);
+  const list = Array.isArray(data) ? data : [data];
+  return list
+    .filter((p) => p && typeof p.Name === 'string')
+    .map((p) => ({ name: p.Name, isDefault: p.Default === true, enabled: p.WorkOffline !== true }));
+}
+
+export function parseWindowsPrintConfig(json) {
+  if (!json || !json.trim()) return null;
+  const data = JSON.parse(json);
+  const colour = typeof data.Color === 'boolean' ? data.Color : null;
+  const mode = String(data.DuplexingMode ?? '');
+  let duplex = null;
+  if (/TwoSided/i.test(mode)) duplex = true;
+  else if (/OneSided/i.test(mode)) duplex = false;
+  return { colour, duplex };
+}
+
+// The -print-settings value SumatraPDF reads, for example "2x,color,duplexlong".
+export function sumatraSettings({ copies, colour, duplex, duplexShort = false }) {
+  const parts = [`${copies}x`, colour ? 'color' : 'monochrome'];
+  if (duplex) parts.push(duplexShort ? 'duplexshort' : 'duplexlong');
+  return parts.join(',');
+}
+
+export function buildSumatraArgs({ printer, file, copies, colour, duplex }) {
+  return [
+    '-print-to', printer,
+    '-print-settings', sumatraSettings({ copies, colour, duplex }),
+    '-silent',
+    '-exit-on-print',
+    file,
+  ];
+}
+
+// The usual install places for SumatraPDF.
+export function findSumatra(env = process.env, exists = existsSync) {
+  const candidates = [
+    path.join(env.ProgramFiles || 'C:\\Program Files', 'SumatraPDF', 'SumatraPDF.exe'),
+    path.join(env['ProgramFiles(x86)'] || 'C:\\Program Files (x86)', 'SumatraPDF', 'SumatraPDF.exe'),
+    path.join(env.LOCALAPPDATA || '', 'SumatraPDF', 'SumatraPDF.exe'),
+  ];
+  return candidates.find((candidate) => candidate && exists(candidate)) ?? null;
+}
+
+export function createWindowsAdapter({ run = runCommand, sumatraPath = null, cacheMs = 60000, now = () => Date.now() } = {}) {
+  let cache = null;
+  const powershell = ['-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-Command'];
+
+  return {
+    platform: 'windows',
+    // SumatraPDF prints PDF only, so pictures are wrapped in a PDF first.
+    acceptsImages: false,
+
+    async listPrinters() {
+      if (cache && now() - cache.at < cacheMs) return cache.printers;
+      const listed = await run('powershell.exe', [...powershell, LIST_SCRIPT]);
+      if (listed.code !== 0) {
+        const err = new Error('Windows did not list the printers.');
+        err.code = 'print_engine_missing';
+        throw err;
+      }
+      const printers = [];
+      for (const printer of parseWindowsPrinters(listed.stdout)) {
+        // Unknown options count as "no", so colour or double-sided orders are not sent blindly.
+        const config = await run('powershell.exe', [...powershell, CONFIG_SCRIPT], {
+          env: { QRQUICK_PRINTER: printer.name },
+        });
+        const parsed = config.code === 0 ? parseWindowsPrintConfig(config.stdout) : null;
+        printers.push({
+          ...printer,
+          capabilitiesKnown: Boolean(parsed && parsed.colour !== null),
+          colour: parsed?.colour === true,
+          duplex: parsed?.duplex === true,
+          papers: null,
+          colourModes: [],
+          duplexModes: [],
+        });
+      }
+      cache = { at: now(), printers };
+      return printers;
+    },
+
+    async print({ printer, file, copies, colour, duplex }) {
+      if (!sumatraPath) {
+        const err = new Error('SumatraPDF is not set up on this computer. See the agent README.');
+        err.code = 'print_engine_missing';
+        throw err;
+      }
+      const result = await run(sumatraPath, buildSumatraArgs({ printer, file, copies, colour, duplex }), {
+        timeoutMs: 180000,
+      });
+      if (result.code !== 0) {
+        const err = new Error(`SumatraPDF stopped with code ${result.code}.`);
+        err.code = 'spooler_error';
+        throw err;
+      }
+      // Windows accepted the job. Whether paper came out is not reported back.
+      return { spoolerId: null };
+    },
+  };
+}
diff --git a/agent/src/runner.mjs b/agent/src/runner.mjs
new file mode 100644
index 0000000..4e42645
--- /dev/null
+++ b/agent/src/runner.mjs
@@ -0,0 +1,34 @@
+// Runs a program with a list of arguments. No shell is involved, so a printer name
+// or a file path can never be read as a command.
+
+import { execFile } from 'node:child_process';
+
+export function runCommand(file, args, { timeoutMs = 60000, env = {} } = {}) {
+  return new Promise((resolve, reject) => {
+    execFile(
+      file,
+      args,
+      {
+        timeout: timeoutMs,
+        windowsHide: true,
+        maxBuffer: 4 * 1024 * 1024,
+        env: { ...process.env, ...env },
+      },
+      (error, stdout, stderr) => {
+        if (error && typeof error.code === 'string') {
+          // ENOENT and similar: the program could not be started at all.
+          const missing = new Error(`${file} could not be started.`);
+          missing.code = error.code;
+          reject(missing);
+          return;
+        }
+        resolve({
+          code: error ? (typeof error.code === 'number' ? error.code : 1) : 0,
+          stdout: String(stdout),
+          stderr: String(stderr),
+          timedOut: Boolean(error?.killed),
+        });
+      },
+    );
+  });
+}
diff --git a/agent/src/sample-page.mjs b/agent/src/sample-page.mjs
