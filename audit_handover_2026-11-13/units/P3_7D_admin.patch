+}
+textarea { min-height: 88px; resize: vertical; }
+input[type="checkbox"] { width: 20px; min-height: 20px; }
+
+:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
+
+button {
+  min-height: 44px;
+  padding: 8px 16px;
+  font: inherit;
+  font-weight: 600;
+  color: var(--accent-ink);
+  background: var(--accent);
