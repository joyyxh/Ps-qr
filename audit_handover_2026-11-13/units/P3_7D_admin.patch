+  --line: #2c323a;
+  --accent: #5b8cff;
+  --accent-ink: #0b0d10;
+  --danger: #ff8a8a;
+  --ok: #7fd9a4;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--ink);
+  font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  overflow-x: hidden;
+}
+
+.skip {
+  position: absolute;
+  left: 16px;
+  top: -48px;
+}
+.skip:focus { top: 8px; background: var(--card); padding: 8px; z-index: 2; }
+
+.top {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  align-items: center;
+  justify-content: space-between;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--line);
