+.kv { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px 12px; margin: 0; }
+.kv dt { font-weight: 600; color: var(--muted); }
+.kv dd { margin: 0 0 8px; overflow-wrap: anywhere; }
+@media (min-width: 600px) {
+  .kv { grid-template-columns: max-content minmax(0, 1fr); }
+  .kv dd { margin: 0; }
+}
+
+.qr { display: block; width: 180px; max-width: 100%; height: auto; margin: 12px 0; background: #fff; }
+.secret { display: inline-block; overflow-wrap: anywhere; font-family: ui-monospace, Menlo, Consolas, monospace; }
