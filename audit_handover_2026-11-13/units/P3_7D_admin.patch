@@ -0,0 +1,74 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { isServiceKey, isUsableConfig } from '../src/config-guard.js';
+import { qrImageSource } from '../src/qr.js';
+import { GENERIC_REJECTION, REJECTION_MESSAGES, rejectionMessage } from '../src/messages.js';
+
+const SQL = readFileSync(new URL('../../supabase/migrations/0012_licence_admin_rpcs.sql', import.meta.url), 'utf8');
+const URL_OK = 'https://project-ref.supabase.co';
+const PUB = 'sb_publishable_example_only';
+
+function jwt(claims) {
+  return `${Buffer.from('{"alg":"HS256"}').toString('base64url')}.${Buffer.from(JSON.stringify(claims)).toString('base64url')}.sig`;
+}
+
+test('a usable configuration needs an https URL and a non-empty publishable key', () => {
+  assert.equal(isUsableConfig({ supabaseUrl: URL_OK, publishableKey: PUB }), true);
+  assert.equal(isUsableConfig({ supabaseUrl: '', publishableKey: '' }), false, 'empty build is not configured');
+  assert.equal(isUsableConfig({ supabaseUrl: 'http://project.example', publishableKey: PUB }), false);
+  assert.equal(isUsableConfig({ supabaseUrl: URL_OK, publishableKey: '   ' }), false);
+  assert.equal(isUsableConfig(null), false);
+});
+
+test('secret keys are refused in every form: sb_secret_ prefix or a service_role JWT', () => {
+  assert.equal(isServiceKey('sb_secret_0000'), true);
+  assert.equal(isServiceKey(jwt({ role: 'service_role' })), true);
+  assert.equal(isServiceKey(jwt({ role: 'authenticated' })), false);
+  assert.equal(isServiceKey(PUB), false);
+  assert.equal(isUsableConfig({ supabaseUrl: URL_OK, publishableKey: 'sb_secret_0000' }), false);
+  assert.equal(isUsableConfig({ supabaseUrl: URL_OK, publishableKey: jwt({ role: 'service_role' }) }), false);
+});
+
+test('the QR code is shown only as an SVG data image, never as markup or another URL', () => {
+  assert.equal(qrImageSource('<svg xmlns="http://www.w3.org/2000/svg"></svg>').startsWith('data:image/svg+xml;charset=utf-8,'), true);
+  assert.equal(qrImageSource('data:image/svg+xml,<svg></svg>'), 'data:image/svg+xml,<svg></svg>');
+  assert.equal(qrImageSource('javascript:alert(1)'), '');
+  assert.equal(qrImageSource('https://example.test/x.png'), '');
+  assert.equal(qrImageSource(undefined), '');
+});
+
+test('every committed rejection code that 0012 can return has a plain-language message', () => {
+  const codes = new Set();
+  for (const m of SQL.matchAll(/licence_admin_reject\('([a-z_]+)'\)/g)) codes.add(m[1]);
+  for (const m of SQL.matchAll(/'([a-z_]+)'::text,\s*null/g)) codes.add(m[1]);
+  codes.add('forbidden');
+  assert.ok(codes.size >= 20, `expected many codes, found ${codes.size}`);
+  for (const code of codes) {
+    assert.ok(Object.hasOwn(REJECTION_MESSAGES, code), `no message for ${code}`);
+  }
+});
+
+test('unknown codes fall back to the generic message, never to the raw code', () => {
+  assert.equal(rejectionMessage('something_new'), GENERIC_REJECTION);
+  assert.equal(rejectionMessage('__proto__'), GENERIC_REJECTION);
+  assert.match(rejectionMessage('overlap'), /overlaps/);
+});
+
+test('every code the admin read RPCs (0013) can return has a plain-language message', () => {
+  const sql13 = readFileSync(new URL('../../supabase/migrations/0013_licence_admin_read_rpcs.sql', import.meta.url), 'utf8');
+  const codes = new Set(['forbidden']); // returned by the shared denial helper in 0012
+  for (const m of sql13.matchAll(/licence_admin_reject\('([a-z_]+)'\)/g)) codes.add(m[1]);
+  assert.ok(codes.has('shop_not_found') && codes.has('invalid_request'), 'expected the read codes');
+  for (const code of codes) {
+    assert.ok(Object.hasOwn(REJECTION_MESSAGES, code), `no message for ${code}`);
+  }
+});
+
+test('the read gate records the same three denial reasons as the write RPCs', () => {
+  const sql13 = readFileSync(new URL('../../supabase/migrations/0013_licence_admin_read_rpcs.sql', import.meta.url), 'utf8');
+  for (const reason of ['no_actor', 'not_platform_admin', 'aal_not_aal2']) {
+    assert.match(sql13, new RegExp(`'${reason}'`), `0013 gate lacks ${reason}`);
+    assert.match(SQL, new RegExp(`'${reason}'`), `0012 lacks ${reason}`);
+  }
+});
diff --git a/admin/tests/licence-api.test.js b/admin/tests/licence-api.test.js
new file mode 100644
index 0000000..7b6bc60
--- /dev/null
+++ b/admin/tests/licence-api.test.js
@@ -0,0 +1,229 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  ACTIONS,
+  ALLOWED_KEYS,
+  buildLicencePayload,
+  callLicenceRpc,
+  createRequestTracker,
+  rpcName,
+  stableStringify,
+} from '../src/licence-api.js';
+
+const SHOP = '8f14e45f-ceea-4b7a-9c1d-2a3b4c5d6e7f';
+const COVERAGE = '3b241101-e2bb-4255-8caf-4136c566a962';
+const CONFIG = { supabaseUrl: 'https://project-ref.supabase.co', publishableKey: 'sb_publishable_example_only' };
+const SQL = readFileSync(new URL('../../supabase/migrations/0012_licence_admin_rpcs.sql', import.meta.url), 'utf8');
+
+function raw(overrides = {}) {
+  return {
+    shop_id: SHOP,
+    expected_state_version: '3',
+    confirm: true,
+    reason: '  Cash received at counter  ',
+    grant_kind: 'one_month',
+    start: '',
+    end: '',
+    backdate_confirm: false,
+    extension_unit: 'month',
+    target_coverage_id: COVERAGE,
+    ...overrides,
+  };
+}
+
+// ---------- allowed keys match the server ----------
+
+function serverAllowedKeys() {
+  const block = SQL.slice(SQL.indexOf('function public.licence_admin_allowed_keys'));
+  const body = block.slice(0, block.indexOf('$$;', block.indexOf('$$')))
+  const result = {};
+  for (const match of body.matchAll(/when '(grant|extend|revoke|replace)'\s+then array\[([^\]]*)\]/g)) {
+    result[match[1]] = [...match[2].matchAll(/'([a-z_]+)'/g)].map((m) => m[1]);
+  }
+  return result;
+}
+
+test('ALLOWED_KEYS equals licence_admin_allowed_keys() in migration 0012, action by action', () => {
+  const server = serverAllowedKeys();
+  assert.deepEqual(Object.keys(server).sort(), [...ACTIONS].sort());
+  for (const action of ACTIONS) {
+    assert.deepEqual(ALLOWED_KEYS[action], server[action], `drift for ${action}`);
+  }
+});
+
+test('RPC names match the four approved 7C admin RPCs', () => {
+  assert.equal(rpcName('grant'), 'licence_admin_grant');
+  assert.equal(rpcName('extend'), 'licence_admin_extend');
+  assert.equal(rpcName('revoke'), 'licence_admin_revoke');
+  assert.equal(rpcName('replace'), 'licence_admin_replace');
+  for (const action of ACTIONS) {
+    assert.ok(SQL.includes(`create or replace function public.licence_admin_${action}(`), `${action} exists in 0012`);
+  }
+});
+
+// ---------- payload building ----------
+
+test('grant payload has exactly the grant keys, trimmed reason, lower-case shop ID and null optionals', () => {
+  const built = buildLicencePayload('grant', raw({ shop_id: SHOP.toUpperCase() }));
+  assert.equal(built.ok, true);
+  assert.deepEqual(Object.keys(built.payload).sort(), [...ALLOWED_KEYS.grant].sort());
+  assert.equal(built.payload.shop_id, SHOP);
+  assert.equal(built.payload.expected_state_version, 3);
+  assert.equal(built.payload.reason, 'Cash received at counter');
+  assert.equal(built.payload.start, null);
+  assert.equal(built.payload.end, null);
+  assert.equal(built.payload.backdate_confirm, false);
+  assert.equal(built.payload.confirm, true);
+  assert.equal('target_coverage_id' in built.payload, false, 'grant must not send a target coverage ID');
+});
+
+test('extend payload never includes licence-type, date or target fields', () => {
+  const built = buildLicencePayload('extend', raw({ extension_unit: 'year' }));
+  assert.equal(built.ok, true);
+  assert.deepEqual(Object.keys(built.payload).sort(), [...ALLOWED_KEYS.extend].sort());
+  assert.equal(built.payload.extension_unit, 'year');
+  for (const key of ['grant_kind', 'start', 'end', 'target_coverage_id', 'backdate_confirm']) {
+    assert.equal(key in built.payload, false, `extend must not send ${key}`);
+  }
+});
+
+test('revoke payload carries the coverage ID and no grant fields', () => {
+  const built = buildLicencePayload('revoke', raw());
+  assert.equal(built.ok, true);
+  assert.equal(built.payload.target_coverage_id, COVERAGE);
+  assert.deepEqual(Object.keys(built.payload).sort(), [...ALLOWED_KEYS.revoke].sort());
+});
+
+test('replace payload carries the target and the grant fields', () => {
+  const built = buildLicencePayload('replace', raw({ grant_kind: 'custom', start: '2026-11-08', end: '2027-02-01' }));
+  assert.equal(built.ok, true);
+  assert.deepEqual(Object.keys(built.payload).sort(), [...ALLOWED_KEYS.replace].sort());
+  assert.equal(built.payload.grant_kind, 'custom');
+  assert.equal(built.payload.start, '2026-11-08');
+  assert.equal(built.payload.end, '2027-02-01');
+});
+
+test('missing confirmation, reason, version or shop each produce a field error', () => {
+  const built = buildLicencePayload('grant', raw({ confirm: false, reason: '  ', expected_state_version: 'x', shop_id: 'nope' }));
+  assert.equal(built.ok, false);
+  assert.equal(built.payload, null);
+  assert.deepEqual(Object.keys(built.errors).sort(), ['confirm', 'expected_state_version', 'reason', 'shop_id']);
+});
+
+test('unknown action is refused without a payload', () => {
+  const built = buildLicencePayload('disable', raw());
+  assert.equal(built.ok, false);
+  assert.ok(built.errors.action);
+});
+
+test('the client never sends a hash, a user ID or a request ID inside the payload', () => {
+  for (const action of ACTIONS) {
+    const built = buildLicencePayload(action, raw({ grant_kind: 'lifetime', extension_unit: 'month' }));
+    if (!built.ok) continue;
+    const text = JSON.stringify(built.payload);
+    assert.equal(/payload_hash|user_id|request_id|actor/.test(text), false, action);
+  }
+});
+
+// ---------- request tracker: retry reuses only an identical unknown request ----------
+
+test('an identical retry after an unknown outcome reuses the request ID', () => {
+  let n = 0;
+  const tracker = createRequestTracker(() => `id-${++n}`);
+  const built = buildLicencePayload('grant', raw()).payload;
+  const first = tracker.requestIdFor('grant', built);
+  tracker.settle(false);
+  assert.equal(tracker.requestIdFor('grant', { ...built }), first);
+});
+
+test('a changed payload gets a new request ID', () => {
+  let n = 0;
+  const tracker = createRequestTracker(() => `id-${++n}`);
+  const a = buildLicencePayload('grant', raw()).payload;
+  const b = buildLicencePayload('grant', raw({ reason: 'Different reason' })).payload;
+  const first = tracker.requestIdFor('grant', a);
+  tracker.settle(false);
+  assert.notEqual(tracker.requestIdFor('grant', b), first);
+});
+
+test('a committed outcome clears the pending ID, so the same payload later is a new operation', () => {
+  let n = 0;
+  const tracker = createRequestTracker(() => `id-${++n}`);
+  const payload = buildLicencePayload('grant', raw()).payload;
+  const first = tracker.requestIdFor('grant', payload);
+  tracker.settle(true);
+  assert.notEqual(tracker.requestIdFor('grant', payload), first);
+});
+
+test('stableStringify ignores key order', () => {
+  assert.equal(stableStringify({ b: 1, a: [2, { d: null, c: true }] }), stableStringify({ a: [2, { c: true, d: null }], b: 1 }));
+});
+
+// ---------- RPC call classification ----------
+
+function fakeFetch(handler) {
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push({ url, init });
+    return handler(url, init);
+  };
+  return { fn, calls };
+}
+
+function json(status, body) {
+  return new Response(body === undefined ? '' : JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
+}
+
+const PAYLOAD = buildLicencePayload('grant', raw()).payload;
+
+test('a committed success is returned as a result with the expected headers, path and body', async () => {
+  const { fn, calls } = fakeFetch(() => json(200, { ok: true, replay: false, action: 'grant', coverage_id: COVERAGE, state_version_after: 4 }));
+  const out = await callLicenceRpc({ config: CONFIG, fetchImpl: fn, accessToken: 'token-value', action: 'grant', requestId: COVERAGE, payload: PAYLOAD });
+  assert.equal(out.kind, 'result');
+  assert.equal(out.data.state_version_after, 4);
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].url, 'https://project-ref.supabase.co/rest/v1/rpc/licence_admin_grant');
+  assert.equal(calls[0].init.method, 'POST');
+  assert.equal(calls[0].init.headers.apikey, 'sb_publishable_example_only');
+  assert.equal(calls[0].init.headers.authorization, 'Bearer token-value');
+  assert.deepEqual(JSON.parse(calls[0].init.body), { p_request_id: COVERAGE, p_payload: PAYLOAD });
+  assert.equal(calls[0].init.credentials, 'omit');
+  assert.equal(calls[0].url.includes('token-value'), false, 'no token in the URL');
+});
+
+test('a committed rejection (ok false) is a result, not an error', async () => {
+  const { fn } = fakeFetch(() => json(200, { ok: false, code: 'stale_state_version' }));
+  const out = await callLicenceRpc({ config: CONFIG, fetchImpl: fn, accessToken: 't', action: 'grant', requestId: COVERAGE, payload: PAYLOAD });
+  assert.deepEqual(out, { kind: 'result', data: { ok: false, code: 'stale_state_version' } });
+});
+
+test('401 asks for a new sign-in; 5xx, timeout and network failure are unknown outcomes', async () => {
+  const a = await callLicenceRpc({ config: CONFIG, fetchImpl: fakeFetch(() => json(401, {})).fn, accessToken: 't', action: 'grant', requestId: COVERAGE, payload: PAYLOAD });
+  assert.equal(a.kind, 'session');
+  const b = await callLicenceRpc({ config: CONFIG, fetchImpl: fakeFetch(() => json(503, {})).fn, accessToken: 't', action: 'grant', requestId: COVERAGE, payload: PAYLOAD });
+  assert.equal(b.kind, 'unknown');
+  const c = await callLicenceRpc({ config: CONFIG, fetchImpl: fakeFetch(() => { throw new TypeError('Failed to fetch'); }).fn, accessToken: 't', action: 'grant', requestId: COVERAGE, payload: PAYLOAD });
+  assert.equal(c.kind, 'unknown');
+});
+
+test('a non-5xx HTTP error is an error that committed nothing; a malformed 200 is unknown', async () => {
+  const a = await callLicenceRpc({ config: CONFIG, fetchImpl: fakeFetch(() => json(400, { code: 'P0001' })).fn, accessToken: 't', action: 'grant', requestId: COVERAGE, payload: PAYLOAD });
+  assert.equal(a.kind, 'error');
+  const b = await callLicenceRpc({ config: CONFIG, fetchImpl: fakeFetch(() => new Response('<html>', { status: 200 })).fn, accessToken: 't', action: 'grant', requestId: COVERAGE, payload: PAYLOAD });
+  assert.equal(b.kind, 'unknown');
+});
+
+test('no request is sent when the configuration is empty', async () => {
+  const { fn, calls } = fakeFetch(() => json(200, { ok: true }));
+  const out = await callLicenceRpc({ config: { supabaseUrl: '', publishableKey: '' }, fetchImpl: fn, accessToken: 't', action: 'grant', requestId: COVERAGE, payload: PAYLOAD });
+  assert.equal(out.kind, 'error');
+  assert.equal(calls.length, 0);
+});
+
+test('an unknown action is refused before any request', async () => {
+  const { fn, calls } = fakeFetch(() => json(200, { ok: true }));
+  const out = await callLicenceRpc({ config: CONFIG, fetchImpl: fn, accessToken: 't', action: 'disable', requestId: COVERAGE, payload: {} });
+  assert.equal(out.kind, 'error');
+  assert.equal(calls.length, 0);
+});
diff --git a/admin/tests/read-api.test.js b/admin/tests/read-api.test.js
new file mode 100644
index 0000000..8b078da
--- /dev/null
+++ b/admin/tests/read-api.test.js
@@ -0,0 +1,233 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  AUDIT_PAGE_SIZE,
+  READ_PARAMS,
+  READ_RPCS,
+  SEARCH_LIMIT,
+  buildAuditBody,
+  buildLicenceBody,
+  buildSearchBody,
+  callReadRpc,
+  hasReadShape,
+} from '../src/read-api.js';
+
+// Parameter names are read from the migration itself, so a renamed or reordered argument fails here.
+const SQL = readFileSync(new URL('../../supabase/migrations/0013_licence_admin_read_rpcs.sql', import.meta.url), 'utf8');
+const CONFIG = { supabaseUrl: 'https://project-ref.supabase.co', publishableKey: 'sb_publishable_example_only' };
+const TOKEN = 'access-token-example-only';
+const SHOP = '8f14e45f-ceea-4b7a-9c1d-2a3b4c5d6e7f';
+const COVERAGE = '3b241101-e2bb-4255-8caf-4136c566a962';
+const ENTRY = '5e1c2d3a-0000-4000-8000-000000000001';
+const ACTOR = '11111111-2222-4333-8444-555555555555';
+
+const SHOP_ITEM = { shop_id: SHOP, slug: 'sunrise-print', name: 'Sunrise Print' };
+const LICENCE = {
+  ok: true,
+  shop: SHOP_ITEM,
+  state_version: 3,
+  state: { state: 'ACTIVE', basis: 'admin_grant', access_until: '2026-12-01T00:00:00+05:30', next_start: null },
+  coverages: [{
+    coverage_id: COVERAGE,
+    kind: 'admin_grant',
+    status: 'current',
+    starts_at: '2026-11-01T00:00:00.123456+05:30',
+    ends_at: '2026-12-01T00:00:00+05:30',
+    reason: 'Cash received',
+  }],
+  coverages_truncated: false,
+};
+const AUDIT_ENTRY = {
+  entry_id: ENTRY,
+  created_at: '2026-11-08T10:00:00.5+05:30',
+  action: 'grant',
+  coverage_id: COVERAGE,
+  reason: 'Cash received',
+  licence_start: null,
+  licence_end: '2026-12-01T00:00:00+05:30',
+  actor_user_id: ACTOR,
+  before_state: {},
+  after_state: {},
+};
+
+function sqlParams(name) {
+  const head = `function public.${name}(`;
+  const start = SQL.indexOf(head);
+  assert.notEqual(start, -1, `${name} is not defined in 0013`);
+  const open = start + head.length;
+  const close = SQL.indexOf(')', open);
+  return SQL.slice(open, close)
+    .split(',')
+    .map((part) => part.trim().split(/\s+/)[0])
+    .filter(Boolean);
+}
+
+function json(status, body) {
+  return new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
+}
+
+function fakeFetch(respond) {
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push({ url, init });
+    return respond(url, init);
+  };
+  return { fn, calls };
+}
+
+// ---------- the functions the client calls ----------
+
+test('the parameter lists match the 0013 function signatures, in the same order', () => {
+  assert.deepEqual(Object.values(READ_RPCS).sort(), Object.keys(READ_PARAMS).sort());
+  for (const rpc of Object.values(READ_RPCS)) {
+    assert.deepEqual([...READ_PARAMS[rpc]], sqlParams(rpc), rpc);
+  }
+});
+
+test('0013 grants the three reads to authenticated only, and the gate to no client role', () => {
+  assert.match(SQL, /revoke all on function public\.licence_admin_read_gate\(text\)\s+from public, anon, authenticated, service_role;/);
+  assert.match(SQL, /revoke execute on function[\s\S]*?from public, anon, service_role;/);
+  assert.match(SQL, /grant execute on function[\s\S]*?to authenticated;/);
+});
+
+// ---------- request shaping ----------
+
+test('search trims the query and counts characters, not UTF-16 units, as the server does', () => {
+  const ok = buildSearchBody('  Sunrise  ');
+  assert.equal(ok.ok, true);
+  assert.deepEqual(ok.body, { p_query: 'Sunrise', p_limit: SEARCH_LIMIT });
+  assert.deepEqual(Object.keys(ok.body), ['p_query', 'p_limit']);
+
+  assert.equal(buildSearchBody('a').ok, false, 'one character is too short');
+  assert.equal(buildSearchBody('   ').ok, false, 'blank is too short');
+  assert.equal(buildSearchBody(null).ok, false);
+  assert.equal(buildSearchBody('😀').ok, false, 'one emoji is one character');
+  assert.equal(buildSearchBody('😀😀').ok, true, 'two emoji are two characters');
+  assert.equal(buildSearchBody('x'.repeat(80)).ok, true);
+  assert.equal(buildSearchBody('x'.repeat(81)).ok, false);
+});
+
+test('a licence view needs a UUID shop ID and sends only p_shop_id', () => {
+  const ok = buildLicenceBody(SHOP);
+  assert.deepEqual(ok, { ok: true, body: { p_shop_id: SHOP } });
+  assert.equal(buildLicenceBody('not-a-uuid').ok, false);
+  assert.equal(buildLicenceBody(undefined).ok, false);
+});
+
+test('audit pages: the first page sends null cursor fields; a later page sends the cursor pair', () => {
+  const first = buildAuditBody(SHOP);
+  assert.equal(first.ok, true);
+  assert.deepEqual(Object.keys(first.body), ['p_shop_id', 'p_after_created_at', 'p_after_id', 'p_limit']);
+  assert.equal(first.body.p_after_created_at, null);
+  assert.equal(first.body.p_after_id, null);
+  assert.equal(first.body.p_limit, AUDIT_PAGE_SIZE);
+
+  const next = buildAuditBody(SHOP, { created_at: '2026-11-08T10:00:00.5+05:30', entry_id: ENTRY });
+  assert.equal(next.ok, true);
+  assert.equal(next.body.p_after_created_at, '2026-11-08T10:00:00.5+05:30');
+  assert.equal(next.body.p_after_id, ENTRY);
+
+  assert.equal(buildAuditBody(SHOP, { created_at: '2026-11-08T10:00:00+05:30' }).ok, false, 'cursor needs both fields');
+  assert.equal(buildAuditBody(SHOP, { created_at: 'yesterday', entry_id: ENTRY }).ok, false);
+  assert.equal(buildAuditBody(SHOP, { created_at: '2026-11-08T10:00:00+05:30', entry_id: 'nope' }).ok, false);
+  assert.equal(buildAuditBody('nope').ok, false);
+});
+
+// ---------- the call ----------
+
+test('a read is never sent without a configuration, a known name or the exact parameter keys', async () => {
+  const { fn, calls } = fakeFetch(() => json(200, { ok: true, shops: [], has_more: false }));
+  const body = buildSearchBody('sun').body;
+
+  assert.equal((await callReadRpc({ config: {}, fetchImpl: fn, accessToken: TOKEN, rpc: READ_RPCS.search, body })).kind, 'error');
+  assert.equal((await callReadRpc({ config: CONFIG, fetchImpl: fn, accessToken: TOKEN, rpc: 'licence_admin_grant', body })).kind, 'error');
+  assert.equal((await callReadRpc({
+    config: CONFIG, fetchImpl: fn, accessToken: TOKEN, rpc: READ_RPCS.search,
+    body: { ...body, p_request_id: 'x' },
+  })).kind, 'error', 'a request ID is never sent to a read');
+  assert.equal((await callReadRpc({
+    config: CONFIG, fetchImpl: fn, accessToken: TOKEN, rpc: READ_RPCS.search,
+    body: { p_limit: 10, p_query: 'sun' },
+  })).kind, 'error', 'key order must match the signature');
+  assert.equal(calls.length, 0, 'nothing was sent');
+});
+
+test('a successful read is posted with the token in a header only, never in the URL', async () => {
+  const { fn, calls } = fakeFetch(() => json(200, { ok: true, shops: [SHOP_ITEM], has_more: false }));
+  const body = buildSearchBody('sun').body;
+  const out = await callReadRpc({ config: CONFIG, fetchImpl: fn, accessToken: TOKEN, rpc: READ_RPCS.search, body });
+
+  assert.deepEqual(out, { kind: 'result', data: { ok: true, shops: [SHOP_ITEM], has_more: false } });
+  assert.equal(calls.length, 1);
+  const [call] = calls;
+  assert.equal(call.url, `${CONFIG.supabaseUrl}/rest/v1/rpc/admin_search_shops`);
+  assert.equal(call.url.includes(TOKEN), false, 'token must not be in the URL');
+  assert.equal(call.init.method, 'POST');
+  assert.equal(call.init.headers.authorization, `Bearer ${TOKEN}`);
+  assert.equal(call.init.headers.apikey, CONFIG.publishableKey);
+  assert.equal(call.init.credentials, 'omit');
+  assert.equal(call.init.cache, 'no-store');
+  assert.equal(call.init.referrerPolicy, 'no-referrer');
+  assert.deepEqual(JSON.parse(call.init.body), body);
+});
+
+test('the response is classified: committed rejection, session refused, or error (never unknown for a read)', async () => {
+  const body = buildLicenceBody(SHOP).body;
+  const run = (respond) => callReadRpc({
+    config: CONFIG, fetchImpl: fakeFetch(respond).fn, accessToken: TOKEN, rpc: READ_RPCS.licence, body,
+  });
+
+  assert.deepEqual(await run(() => json(200, { ok: false, code: 'shop_not_found' })), { kind: 'rejected', code: 'shop_not_found' });
+  assert.deepEqual(await run(() => json(200, { ok: false, code: 'forbidden' })), { kind: 'rejected', code: 'forbidden' });
+  assert.equal((await run(() => json(401, {}))).kind, 'session');
+  assert.equal((await run(() => json(500, {}))).kind, 'error', 'a 5xx is a plain error for a read');
+  assert.equal((await run(() => json(403, {}))).kind, 'error');
+  assert.equal((await run(() => { throw new TypeError('network'); })).kind, 'error');
+  assert.equal((await run(() => new Response('not json', { status: 200 }))).kind, 'error');
+  assert.equal((await run(() => json(200, { ok: true, shops: 'x' }))).kind, 'error', 'wrong shape for the licence view');
+});
+
+test('a read is sent once: a failed read is not retried', async () => {
+  const { fn, calls } = fakeFetch(() => json(500, {}));
+  await callReadRpc({
+    config: CONFIG, fetchImpl: fn, accessToken: TOKEN, rpc: READ_RPCS.audit, body: buildAuditBody(SHOP).body,
+  });
+  assert.equal(calls.length, 1);
+});
+
+// ---------- response shape ----------
+
+test('the search response needs a shop list, has_more and well-formed shops', () => {
+  assert.equal(hasReadShape(READ_RPCS.search, { ok: true, shops: [SHOP_ITEM], has_more: false }), true);
+  assert.equal(hasReadShape(READ_RPCS.search, { ok: true, shops: [] }), false, 'has_more is required');
+  assert.equal(hasReadShape(READ_RPCS.search, { ok: true, shops: [{ ...SHOP_ITEM, shop_id: 'x' }], has_more: false }), false);
+  assert.equal(hasReadShape(READ_RPCS.search, { ok: true, shops: 'none', has_more: false }), false);
+});
+
+test('the licence response needs a version, a state, coverages and the truncation flag', () => {
+  assert.equal(hasReadShape(READ_RPCS.licence, LICENCE), true);
+  assert.equal(hasReadShape(READ_RPCS.licence, { ...LICENCE, state_version: -1 }), false);
+  assert.equal(hasReadShape(READ_RPCS.licence, { ...LICENCE, state_version: 1.5 }), false);
+  assert.equal(hasReadShape(READ_RPCS.licence, { ...LICENCE, state: { ...LICENCE.state, state: 'BOGUS' } }), false);
+  assert.equal(hasReadShape(READ_RPCS.licence, { ...LICENCE, state: { ...LICENCE.state, access_until: 'soon' } }), false);
+  assert.equal(hasReadShape(READ_RPCS.licence, { ...LICENCE, coverages: [{ ...LICENCE.coverages[0], kind: 'other' }] }), false);
+  assert.equal(hasReadShape(READ_RPCS.licence, { ...LICENCE, coverages: [{ ...LICENCE.coverages[0], starts_at: '2026-11-01' }] }), false, 'a date alone is not a timestamp');
+  assert.equal(hasReadShape(READ_RPCS.licence, { ...LICENCE, coverages: [{ ...LICENCE.coverages[0], ends_at: null }] }), true, 'a lifetime coverage has no end');
+  const { coverages_truncated: _omitted, ...withoutFlag } = LICENCE;
+  assert.equal(hasReadShape(READ_RPCS.licence, withoutFlag), false);
+});
+
+test('the audit response needs entries and a next cursor or null', () => {
+  assert.equal(hasReadShape(READ_RPCS.audit, { ok: true, entries: [AUDIT_ENTRY], next: null }), true);
+  assert.equal(hasReadShape(READ_RPCS.audit, { ok: true, entries: [], next: { created_at: '2026-11-08T10:00:00+05:30', entry_id: ENTRY } }), true);
+  assert.equal(hasReadShape(READ_RPCS.audit, { ok: true, entries: [], next: { created_at: 'x', entry_id: ENTRY } }), false);
+  assert.equal(hasReadShape(READ_RPCS.audit, { ok: true, entries: [{ ...AUDIT_ENTRY, action: 'delete' }], next: null }), false);
+  assert.equal(hasReadShape(READ_RPCS.audit, { ok: true, entries: [{ ...AUDIT_ENTRY, created_at: '2026-11-08T10:00:00' }], next: null }), false, 'a timestamp needs a zone');
+  assert.equal(hasReadShape(READ_RPCS.audit, { ok: true, entries: [{ ...AUDIT_ENTRY, licence_end: null }], next: null }), true);
+  assert.equal(hasReadShape(READ_RPCS.audit, { ok: true, entries: [{ ...AUDIT_ENTRY, actor_user_id: 'me' }], next: null }), false);
+});
+
+test('an unknown RPC name has no response shape', () => {
+  assert.equal(hasReadShape('licence_admin_grant', { ok: true }), false);
+});
diff --git a/admin/tests/read-model.test.js b/admin/tests/read-model.test.js
new file mode 100644
index 0000000..58c7dce
--- /dev/null
+++ b/admin/tests/read-model.test.js
@@ -0,0 +1,155 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  AUDIT_ACTION_LABELS,
+  KIND_LABELS,
+  STATE_LABELS,
+  auditRows,
+  coverageLabel,
+  formatIst,
+  licenceFacts,
+} from '../src/read-model.js';
+
+const MIGRATION_0011 = readFileSync(new URL('../../supabase/migrations/0011_licence_foundation.sql', import.meta.url), 'utf8');
+const SHOP = { shop_id: '8f14e45f-ceea-4b7a-9c1d-2a3b4c5d6e7f', slug: 'sunrise-print', name: 'Sunrise Print' };
+
+function listFromCheck(pattern) {
+  const match = MIGRATION_0011.match(pattern);
+  assert.ok(match, `pattern not found in 0011: ${pattern}`);
+  return match[1].split(',').map((item) => item.trim().replace(/'/g, '')).sort();
+}
+
+// ---------- labels ----------
+
+test('the labels cover exactly the values the database allows', () => {
+  assert.deepEqual(
+    Object.keys(AUDIT_ACTION_LABELS).sort(),
+    listFromCheck(/licence_audit_log_action check \(\s*action in \(([^)]*)\)/),
+  );
+  assert.deepEqual(Object.keys(KIND_LABELS).sort(), listFromCheck(/licence_coverages_kind check \(kind in \(([^)]*)\)/));
+  assert.deepEqual(Object.keys(STATE_LABELS).sort(), ['ACTIVE', 'EXPIRED', 'NONE', 'REVOKED', 'SCHEDULED']);
+});
+
+// ---------- times ----------
+
+test('times are shown in India Standard Time, not UTC', () => {
+  // 2026-11-08 23:30 UTC is 9 November 05:00 in India. A UTC display would say 8 November.
+  const text = formatIst('2026-11-08T23:30:00Z');
+  assert.match(text, /IST$/);
+  assert.match(text, /\b9\b/);
+  assert.match(text, /2026/);
+});
+
+test('an empty time reads None and an unreadable time is named as such', () => {
+  assert.equal(formatIst(null), 'None');
+  assert.equal(formatIst(''), 'None');
+  assert.equal(formatIst('not a date'), 'Time not readable');
+});
+
+// ---------- licence view ----------
+
+test('an active licence shows its access end, with no next start', () => {
+  const rows = licenceFacts({
+    shop: SHOP,
+    state_version: 3,
+    state: { state: 'ACTIVE', basis: 'admin_grant', access_until: '2026-12-01T00:00:00+05:30', next_start: null },
+    coverages: [],
+    coverages_truncated: false,
+  });
+  const labels = rows.map(([label]) => label);
+  assert.deepEqual(labels, ['Shop', 'State', 'Access ends', 'State version']);
+  assert.deepEqual(rows[0], ['Shop', 'Sunrise Print (sunrise-print)']);
+  assert.equal(rows[1][1], 'Active');
+  assert.equal(rows[3][1], '3');
+});
+
+test('a scheduled licence shows its next start', () => {
+  const rows = licenceFacts({
+    shop: SHOP,
+    state_version: 1,
+    state: { state: 'SCHEDULED', basis: null, access_until: null, next_start: '2026-12-01T00:00:00+05:30' },
+    coverages: [],
+    coverages_truncated: false,
+  });
+  const labels = rows.map(([label]) => label);
+  assert.equal(labels.includes('Next start'), true);
+  assert.equal(labels.includes('Access ends'), false);
+});
+
+test('a shop with no licence shows the no-licence state and no dates', () => {
+  const rows = licenceFacts({
+    shop: SHOP,
+    state_version: 0,
+    state: { state: 'NONE', basis: null, access_until: null, next_start: null },
+    coverages: [],
+    coverages_truncated: false,
+  });
+  assert.deepEqual(rows.map(([label]) => label), ['Shop', 'State', 'State version']);
+  assert.equal(rows[1][1], 'No licence');
+});
+
+test('an unexpected state is shown as Unknown rather than echoed', () => {
+  const rows = licenceFacts({
+    shop: SHOP,
+    state_version: 2,
+    state: { state: '<img src=x>', basis: null, access_until: null, next_start: null },
+    coverages: [],
+    coverages_truncated: false,
+  });
+  assert.equal(rows[1][1], 'Unknown');
+});
+
+// ---------- coverages ----------
+
+test('a coverage label names its kind, its status and its period, and an open end reads no end', () => {
+  const current = coverageLabel({
+    kind: 'admin_grant', status: 'current', starts_at: '2026-11-01T00:00:00+05:30', ends_at: '2026-12-01T00:00:00+05:30',
+  });
+  assert.match(current, /^Admin grant, current: .* to .*IST$/);
+
+  const lifetime = coverageLabel({
+    kind: 'lifetime_grant', status: 'scheduled', starts_at: '2026-12-01T00:00:00+05:30', ends_at: null,
+  });
+  assert.match(lifetime, /^Lifetime grant, scheduled: /);
+  assert.match(lifetime, /to no end$/);
+});
+
+// ---------- audit ----------
+
+test('an audit entry shows its action, reason and coverage, and a missing coverage reads None', () => {
+  const rows = auditRows({
+    entry_id: '5e1c2d3a-0000-4000-8000-000000000001',
+    created_at: '2026-11-08T10:00:00+05:30',
+    action: 'revoke',
+    coverage_id: null,
+    reason: 'Refund agreed',
+    licence_start: null,
+    licence_end: null,
+    actor_user_id: '11111111-2222-4333-8444-555555555555',
+    before_state: {},
+    after_state: {},
+  });
+  const byLabel = Object.fromEntries(rows);
+  assert.equal(byLabel.Action, 'Revocation');
+  assert.equal(byLabel.Reason, 'Refund agreed');
+  assert.equal(byLabel['Coverage ID'], 'None');
+  assert.equal(byLabel['Licence start'], 'None');
+  // N5 (open): the recording admin's ID is not displayed. The data is kept; the view omits it.
+  assert.equal('Recorded by' in byLabel, false, 'the recording admin must not be shown (N5)');
+  assert.equal(JSON.stringify(rows).includes('11111111-2222-4333-8444-555555555555'), false);
+});
+
+test('an unknown audit action is shown as Unknown', () => {
+  const rows = auditRows({
+    entry_id: '5e1c2d3a-0000-4000-8000-000000000002',
+    created_at: '2026-11-08T10:00:00+05:30',
+    action: 'delete',
+    coverage_id: null,
+    reason: 'x',
+    licence_start: null,
+    licence_end: null,
+    actor_user_id: '11111111-2222-4333-8444-555555555555',
+  });
+  assert.equal(Object.fromEntries(rows).Action, 'Unknown');
+});
diff --git a/admin/tests/security.test.js b/admin/tests/security.test.js
new file mode 100644
index 0000000..6fe3259
--- /dev/null
+++ b/admin/tests/security.test.js
@@ -0,0 +1,92 @@
+// Static checks on the admin panel's own files. These do not replace server-side checks. They stop
+// common mistakes from reaching a private deployment: HTML injection, secrets in the bundle,
+// persistent token storage, third-party loads and an indexable page.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import { join, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ADMIN = fileURLToPath(new URL('..', import.meta.url));
+
+function walk(dir) {
+  const out = [];
+  for (const name of readdirSync(dir)) {
+    if (name === 'node_modules' || name === 'tests') continue;
+    const full = join(dir, name);
+    if (statSync(full).isDirectory()) out.push(...walk(full));
+    else out.push(full);
+  }
+  return out;
+}
+
+const SHIPPED = walk(ADMIN).filter((f) => /\.(js|html|css|txt|json|webmanifest)$/.test(f));
+const SOURCE = SHIPPED.filter((f) => f.endsWith('.js'));
+const read = (rel) => readFileSync(join(ADMIN, rel), 'utf8');
+
+function relPath(f) {
+  return relative(ADMIN, f);
+}
+
+test('no HTML sinks: server data is written with textContent only', () => {
+  const sinks = /\.innerHTML\b|\.outerHTML\b|insertAdjacentHTML|document\.write|\beval\s*\(|new Function\s*\(|setTimeout\s*\(\s*['"`]/;
+  for (const file of SOURCE) {
+    assert.equal(sinks.test(readFileSync(file, 'utf8')), false, `HTML sink in ${relPath(file)}`);
+  }
+});
+
+test('no persistent browser storage for tokens or any other state', () => {
+  const storage = /localStorage|sessionStorage|indexedDB|document\.cookie|openDatabase/;
+  for (const file of SHIPPED) {
+    assert.equal(storage.test(readFileSync(file, 'utf8')), false, `storage use in ${relPath(file)}`);
+  }
+});
+
+test('only the publishable key path exists: no secret key literal outside the guard', () => {
+  for (const file of SHIPPED) {
+    const text = readFileSync(file, 'utf8');
+    const name = relPath(file);
+    if (name === join('src', 'config-guard.js')) continue;
+    assert.equal(/sb_secret_|service_role/.test(text), false, `secret-key reference in ${name}`);
+  }
+});
+
+test('modules import only from inside the admin folder and never from the public web app', () => {
+  for (const file of SOURCE) {
+    const text = readFileSync(file, 'utf8');
+    for (const match of text.matchAll(/from\s+['"]([^'"]+)['"]/g)) {
+      assert.match(match[1], /^\.\/[^']+\.js$/, `${relPath(file)} imports ${match[1]}`);
+    }
+    assert.equal(/\bweb\//.test(text), false, `${relPath(file)} refers to the public web folder`);
+  }
+});
+
+test('the page sets a strict Content Security Policy and has no inline script or handlers', () => {
+  const html = read('index.html');
+  assert.match(html, /http-equiv="Content-Security-Policy"/);
+  assert.match(html, /default-src 'none'/);
+  assert.match(html, /script-src 'self'/);
+  assert.match(html, /connect-src 'self' https:\/\/\*\.supabase\.co/);
+  assert.equal(/<script(?![^>]*\ssrc=)[^>]*>/i.test(html), false, 'inline script');
+  assert.equal(/\son[a-z]+\s*=/i.test(html), false, 'inline event handler');
+  assert.equal(/(src|href)="https?:\/\//i.test(html), false, 'external resource');
+});
+
+test('the page is private: noindex, no-referrer, and robots.txt disallows everything', () => {
+  const html = read('index.html');
+  assert.match(html, /name="robots" content="noindex, nofollow, noarchive"/);
+  assert.match(html, /name="referrer" content="no-referrer"/);
+  assert.match(read('robots.txt'), /^User-agent: \*\s*\nDisallow: \/\s*$/m);
+});
+
+test('the committed configuration is empty: this build targets no project', () => {
+  const config = read('config.js');
+  assert.match(config, /supabaseUrl: ''/);
+  assert.match(config, /publishableKey: ''/);
+});
+
+test('no plain http URL is used anywhere in the panel', () => {
+  for (const file of SHIPPED) {
+    assert.equal(/http:\/\/(?!localhost)/.test(readFileSync(file, 'utf8')), false, `http URL in ${relPath(file)}`);
+  }
+});
diff --git a/admin/tests/validate.test.js b/admin/tests/validate.test.js
new file mode 100644
index 0000000..adc44d9
--- /dev/null
+++ b/admin/tests/validate.test.js
@@ -0,0 +1,48 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  REASON_MAX_CHARS,
+  isUuid,
+  normaliseInstant,
+  normaliseReason,
+  parseStateVersion,
+} from '../src/validate.js';
+
+test('isUuid accepts the canonical form only', () => {
+  assert.equal(isUuid('8f14e45f-ceea-4b7a-9c1d-2a3b4c5d6e7f'), true);
+  assert.equal(isUuid('8F14E45F-CEEA-4B7A-9C1D-2A3B4C5D6E7F'), true);
+  assert.equal(isUuid('8f14e45fceea4b7a9c1d2a3b4c5d6e7f'), false);
+  assert.equal(isUuid('not-a-uuid'), false);
+  assert.equal(isUuid(null), false);
+  assert.equal(isUuid(42), false);
+});
+
+test('parseStateVersion accepts whole numbers from 0 and rejects anything else', () => {
+  assert.deepEqual(parseStateVersion('0'), { ok: true, value: 0 });
+  assert.deepEqual(parseStateVersion(' 17 '), { ok: true, value: 17 });
+  assert.equal(parseStateVersion('-1').ok, false);
+  assert.equal(parseStateVersion('1.5').ok, false);
+  assert.equal(parseStateVersion('01').ok, false);
+  assert.equal(parseStateVersion('').ok, false);
+  assert.equal(parseStateVersion('1234567890123456789').ok, false);
+});
+
+test('normaliseReason trims, requires one character and caps the length in characters', () => {
+  assert.deepEqual(normaliseReason('  paid by cheque  '), { ok: true, value: 'paid by cheque' });
+  assert.equal(normaliseReason('   ').ok, false);
+  assert.equal(normaliseReason('').ok, false);
+  assert.equal(normaliseReason('a'.repeat(REASON_MAX_CHARS)).ok, true);
+  assert.equal(normaliseReason('a'.repeat(REASON_MAX_CHARS + 1)).ok, false);
+  // Multi-byte characters count once each.
+  assert.equal(normaliseReason('ष'.repeat(REASON_MAX_CHARS)).ok, true);
+});
+
+test('normaliseInstant treats empty as null and accepts dates or zoned timestamps only', () => {
+  assert.deepEqual(normaliseInstant(''), { ok: true, value: null });
+  assert.deepEqual(normaliseInstant('  '), { ok: true, value: null });
+  assert.deepEqual(normaliseInstant('2026-11-08'), { ok: true, value: '2026-11-08' });
+  assert.deepEqual(normaliseInstant('2026-11-08T10:00:00+05:30'), { ok: true, value: '2026-11-08T10:00:00+05:30' });
+  assert.deepEqual(normaliseInstant('2026-11-08T04:30:00Z'), { ok: true, value: '2026-11-08T04:30:00Z' });
+  assert.equal(normaliseInstant('8 Nov 2026').ok, false);
+  assert.equal(normaliseInstant('2026-11-08T10:00:00').ok, false); // no zone
+});
