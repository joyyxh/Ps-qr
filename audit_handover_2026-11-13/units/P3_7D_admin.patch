+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 16px;
+}
+.wrap:focus { outline: none; }
+
+h1 { font-size: 1.4rem; margin: 0 0 8px; }
+h2 { font-size: 1.15rem; margin: 0 0 8px; }
+
+.card {
