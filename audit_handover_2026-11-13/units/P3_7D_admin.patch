+  --accent-ink: #ffffff;
+  --danger: #a4161a;
+  --ok: #0f6b3a;
+  --focus: #f59e0b;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --bg: #0f1113;
+    --card: #181b1f;
+    --ink: #eceef1;
+    --muted: #a7b0ba;
+    --line: #2c323a;
+    --accent: #5b8cff;
+    --accent-ink: #0b0d10;
+    --danger: #ff8a8a;
