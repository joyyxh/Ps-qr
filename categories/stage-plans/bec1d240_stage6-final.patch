@@ -0,0 +1,259 @@
+// Offline simulation for testing the order-to-print steps without a printer.
+//
+// This module never contacts QRquick. Jobs come from a local fixture file, the "server" is an
+// in-memory copy of the server's job rules, files are read from the fixture folder, and the
+// printer is the simulated adapter. Nothing here can reach a database, so a simulated job can
+// never be recorded as a real "sent" on any server.
+//
+// The in-memory server follows the same rules as migration 0010 (agent_claim_next_job,
+// agent_mark_printing and agent_finish_job). A test reads the migration to check that these
+// rules still match it.
+
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { AgentApiError } from './api.mjs';
+import { createJournal } from './journal.mjs';
+import { createSimulatedAdapter } from './printers/simulated.mjs';
+import { createWorker } from './worker.mjs';
+
+export const SIMULATION_BANNER =
+  'SIMULATION ONLY. Nothing is sent to QRquick or to any printer, and no paper comes out. Jobs come from a local file.';
+export const SAMPLE_FILE_NAME = 'sample.pdf';
+
+const MAX_JOBS = 50;
+const JOB_STATES = ['queued', 'printing', 'needs_check'];
+const DEFAULT_MAX_STEPS = 200;
+
+// Raised when a simulation would not stop on its own. It is a safety net, not a normal result.
+export class SimulationStopped extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'SimulationStopped';
+  }
+}
+
+// Checks a fixture file before anything runs. One problem refuses the whole file, so a
+// partly valid file is never half simulated. Only approved and paid orders are accepted,
+// which mirrors the server's rule that a print job exists only for an approved, paid order.
+export function readFixtureJobs(data, fixtureDir) {
+  if (!data || typeof data !== 'object' || !Array.isArray(data.jobs)) {
+    throw new Error('The fixture file needs a "jobs" list.');
+  }
+  if (data.jobs.length < 1 || data.jobs.length > MAX_JOBS) {
+    throw new Error(`The fixture file must have from 1 to ${MAX_JOBS} jobs.`);
+  }
+  const root = path.resolve(fixtureDir);
+  const seen = new Set();
+  return data.jobs.map((raw, index) => {
+    const label = `Job ${index + 1}`;
+    if (!raw || typeof raw !== 'object') throw new Error(`${label} is not an object.`);
+
+    const jobId = raw.job_id;
+    if (typeof jobId !== 'string' || !/^[A-Za-z0-9-]{1,64}$/.test(jobId)) {
+      throw new Error(`${label} needs a job_id made of letters, digits and dashes.`);
+    }
+    if (seen.has(jobId)) throw new Error(`The job_id "${jobId}" appears more than once.`);
+    seen.add(jobId);
+
+    if (raw.approved !== true || raw.paid !== true) {
+      throw new Error(
+        `"${jobId}" is not approved and paid. Only approved, paid orders can be simulated, as on the real server. Nothing was simulated.`,
+      );
+    }
+
+    const attempt = raw.attempt ?? 1;
+    if (!Number.isInteger(attempt) || attempt < 1 || attempt > 100) {
+      throw new Error(`"${jobId}" has an invalid attempt number.`);
+    }
+    const state = raw.state ?? 'queued';
+    if (!JOB_STATES.includes(state)) throw new Error(`"${jobId}" has an unknown state "${state}".`);
+
+    if (typeof raw.file !== 'string' || raw.file === '' || path.isAbsolute(raw.file) || raw.file.includes('\0')) {
+      throw new Error(`"${jobId}" needs a file name inside the fixture folder.`);
+    }
+    const filePath = path.resolve(root, raw.file);
+    if (!filePath.startsWith(root + path.sep)) {
+      throw new Error(`"${jobId}" points outside the fixture folder. Nothing was simulated.`);
+    }
+    if (raw.size_bytes !== undefined && (!Number.isInteger(raw.size_bytes) || raw.size_bytes < 0)) {
+      throw new Error(`"${jobId}" has an invalid size_bytes.`);
+    }
+    if (raw.printer !== undefined && raw.printer !== null && typeof raw.printer !== 'string') {
+      throw new Error(`"${jobId}" has an invalid printer name.`);
+    }
+
+    return {
+      jobId,
+      attempt,
+      state,
+      filePath,
+      settings: raw.settings && typeof raw.settings === 'object' ? raw.settings : {},
+      printer: raw.printer ?? null,
+      sizeBytes: raw.size_bytes,
+    };
+  });
+}
+
+// The in-memory stand-in for the server. It has no network code. It is the only "server"
+// a simulation has, and it follows the same rules as migration 0010:
+//   - a job is claimed only from 'queued' (so 'printing' and 'needs_check' are never printed again);
+//   - 'printing' is recorded only for a claimed job with the same attempt;
+//   - 'sent' is accepted only from 'printing' or 'needs_check';
+//   - 'failed' is accepted only from 'claimed' or 'printing'.
+export function createSimulatedServer(jobs, { abort = () => {} } = {}) {
+  const records = jobs.map((job) => ({
+    jobId: job.jobId,
+    attempt: job.attempt,
+    state: job.state,
+    filePath: job.filePath,
+    settings: job.settings,
+    printer: job.printer,
+    sizeBytes: job.sizeBytes,
+    simulated: false,
+    errorCode: null,
+  }));
+  const calls = [];
+  let claims = 0;
+
+  function find(jobRef) {
+    return records.find((r) => r.jobId === jobRef.jobId && r.attempt === jobRef.attempt) ?? null;
+  }
+  const lost = () => new AgentApiError(409, 'lease_lost', 'The job was taken back.');
+
+  const api = {
+    async heartbeat() {
+      calls.push('heartbeat');
+      return { ok: true };
+    },
+
+    async claim() {
+      calls.push('claim');
+      claims += 1;
+      // Each job can be claimed once. Anything beyond that is a bug, so the simulation ends.
+      if (claims > jobs.length + 1) {
+        abort();
+        return { job: null };
+      }
+      const next = records.find((r) => r.state === 'queued');
+      if (!next) {
+        abort();
+        return { job: null };
+      }
+      next.state = 'claimed';
+      return {
+        job: {
+          job_id: next.jobId,
+          attempt: next.attempt,
+          settings: next.settings,
+          printer: next.printer,
+          file_url: next.filePath,
+          size_bytes: next.sizeBytes,
+        },
+      };
+    },
+
+    async markPrinting(jobRef) {
+      calls.push('printing');
+      const r = find(jobRef);
+      if (!r || r.state !== 'claimed') throw lost();
+      r.state = 'printing';
+      return { ok: true };
+    },
+
+    async finish(jobRef, { outcome, errorCode = null }) {
+      calls.push(`finish:${outcome}`);
+      const r = find(jobRef);
+      if (!r) throw lost();
+      if (r.state === outcome) return { ok: true, already_recorded: true };
+      if (outcome === 'sent' && (r.state === 'printing' || r.state === 'needs_check')) {
+        r.state = 'sent';
+        r.simulated = true;
+        return { ok: true };
+      }
+      if (outcome === 'failed' && (r.state === 'claimed' || r.state === 'printing')) {
+        r.state = 'failed';
+        r.errorCode = errorCode;
+        return { ok: true };
+      }
+      throw lost();
+    },
+  };
+
+  return { api, records, calls };
+}
+
+// Reads a file from the fixture folder only. Nothing is downloaded from anywhere.
+async function readFixtureFile(filePath, { root, maxBytes }) {
+  if (!filePath.startsWith(root + path.sep)) {
+    const err = new Error('The file is outside the fixture folder.');
+    err.code = 'download_failed';
+    throw err;
+  }
+  const bytes = await readFile(filePath);
+  if (bytes.length > maxBytes) {
+    const err = new Error('The file is larger than the 10 MB limit.');
+    err.code = 'file_too_large';
+    throw err;
+  }
+  return bytes;
+}
+
+// Runs the real worker over the jobs, with the simulated server and the simulated printer.
+// Returns the final state of each job. A loop that would never end stops with SimulationStopped.
+export async function runSimulation({
+  jobs,
+  fixtureDir,
+  out = () => {},
+  version = '0.1.0',
+  maxSteps = DEFAULT_MAX_STEPS,
+  server,
+}) {
+  const work = await mkdtemp(path.join(os.tmpdir(), 'qrquick-simulation-'));
+  try {
+    const controller = new AbortController();
+    const fake = server ?? createSimulatedServer(jobs, { abort: () => controller.abort() });
+    const adapter = createSimulatedAdapter();
+    const root = path.resolve(fixtureDir);
+    let steps = 0;
+    const worker = createWorker({
+      api: fake.api,
+      adapter,
+      journal: createJournal(path.join(work, 'outbox.json')),
+      download: (filePath, { maxBytes }) => readFixtureFile(filePath, { root, maxBytes }),
+      config: {},
+      workDir: path.join(work, 'job-files'),
+      log: (line) => out(line),
+      // Every pause counts as a step. A loop that never ends hits the limit and stops.
+      sleep: async () => {
+        steps += 1;
+        if (steps > maxSteps) {
+          throw new SimulationStopped('The simulation stopped at its safety limit. Nothing more was simulated.');
+        }
+        await new Promise((resolve) => setImmediate(resolve));
+      },
+      pollMs: 0,
+      version,
+    });
+    await worker.run({ signal: controller.signal });
+    return { records: fake.records, prints: adapter.prints, calls: fake.calls ?? [] };
+  } finally {
+    await rm(work, { recursive: true, force: true });
+  }
+}
+
+// The scenario used when "simulate" is run with no file. The caller writes SAMPLE_FILE_NAME
+// into the fixture folder first. It covers a normal job, a job the printer cannot do, a job
+// already printing, and a job that needs a check.
+export function builtInFixture() {
+  const settings = { copies: 1, colour: false, duplex: false, paper: 'A4' };
+  const base = { approved: true, paid: true, file: SAMPLE_FILE_NAME, printer: null };
+  return {
+    jobs: [
+      { ...base, job_id: 'sim-0001', attempt: 1, state: 'queued', settings },
+      { ...base, job_id: 'sim-0002', attempt: 1, state: 'queued', settings: { ...settings, paper: 'A3' } },
+      { ...base, job_id: 'sim-0003', attempt: 1, state: 'printing', settings },
+      { ...base, job_id: 'sim-0004', attempt: 1, state: 'needs_check', settings },
+    ],
+  };
+}
diff --git a/agent/test/simulated.test.mjs b/agent/test/simulated.test.mjs
new file mode 100644
index 0000000..c0edb94
--- /dev/null
+++ b/agent/test/simulated.test.mjs
@@ -0,0 +1,231 @@
+// The simulated printer and the worker steps it drives. The server is a fake at the worker's
+// edge. No real printer, program or server is used by these tests.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { AgentApiError } from '../src/api.mjs';
+import { createJournal } from '../src/journal.mjs';
+import { createSimulatedAdapter, SIMULATED_PRINTER_NAME } from '../src/printers/simulated.mjs';
+import { createWorker } from '../src/worker.mjs';
+
+const JOB_ID = '11111111-2222-4333-8444-555555555555';
+const PDF = Buffer.from('%PDF-1.4\n% test file\n%%EOF\n');
+const JPEG = Buffer.from([0xff, 0xd8, 0xff, 0xc0, 0x00, 0x0b, 0x08, 0x00, 0x08, 0x00, 0x08, 0x01, 0x01, 0x11, 0x00, 0xff, 0xd9]);
+
+async function tempDir(t) {
+  const dir = await mkdtemp(path.join(os.tmpdir(), 'qrq-sim-'));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+function job(bytes = PDF, extra = {}) {
+  return {
+    job_id: JOB_ID,
+    attempt: 1,
+    settings: { copies: 1, colour: false, duplex: false, paper: 'A4' },
+    printer: null,
+    file_url: 'https://files.example/signed-link',
+    size_bytes: bytes.length,
+    file_name: 'menu.pdf',
+    ...extra,
+  };
+}
+
+// A worker with the real simulated adapter. "events" records the server calls and the
+// simulated prints in order, so tests can check that "printing" comes before the print.
+async function harness(t, { adapterOptions = {}, bytes = PDF, download, api: apiOverrides = {}, config = {} } = {}) {
+  const dir = await tempDir(t);
+  const adapter = createSimulatedAdapter(adapterOptions);
+  const events = [];
+  const reports = [];
+  const logs = [];
+  const realPrint = adapter.print;
+  adapter.print = async (opts) => {
+    events.push('print');
+    return realPrint(opts);
+  };
+  const api = {
+    heartbeat: async () => ({ ok: true }),
+    claim: async () => ({ job: null }),
+    markPrinting: async () => {
+      events.push('printing');
+      return { ok: true };
+    },
+    finish: async (ref, result) => {
+      events.push(result.outcome);
+      reports.push({ ref, ...result });
+      return { ok: true };
+    },
+    ...apiOverrides,
+  };
+  const worker = createWorker({
+    api,
+    adapter,
+    journal: createJournal(path.join(dir, 'outbox.json')),
+    download: download ?? (async () => bytes),
+    config,
+    workDir: path.join(dir, 'work'),
+    log: (line) => logs.push(line),
+    sleep: async () => {},
+    heartbeatMs: 1e9,
+  });
+  return { worker, adapter, events, reports, logs, dir };
+}
+
+test('the simulated printer is clearly named, marked simulated, and is the default', async () => {
+  const adapter = createSimulatedAdapter();
+  const [printer] = await adapter.listPrinters();
+  assert.equal(printer.name, SIMULATED_PRINTER_NAME);
+  assert.match(printer.name, /SIMULATED/);
+  assert.equal(printer.isDefault, true);
+  assert.equal(printer.enabled, true);
+  assert.equal(adapter.simulated, true);
+});
+
+test('simulated results are deterministic: each accepted job gets the next simulated id', async (t) => {
+  const dir = await tempDir(t);
+  const file = path.join(dir, 'job.pdf');
+  await writeFile(file, PDF);
+  const adapter = createSimulatedAdapter();
+  const options = { printer: SIMULATED_PRINTER_NAME, file, copies: 1, colour: false, duplex: false, paper: 'A4', title: 'QRquick' };
+  const first = await adapter.print(options);
+  const second = await adapter.print(options);
+  assert.equal(first.spoolerId, 'simulated-1');
+  assert.equal(second.spoolerId, 'simulated-2');
+  assert.equal(adapter.prints.length, 2);
+});
+
+test('the simulated spooler refuses a non-PDF file or a printer it does not have', async (t) => {
+  const dir = await tempDir(t);
+  const file = path.join(dir, 'job.gif');
+  await writeFile(file, Buffer.from('GIF89a................', 'latin1'));
+  const adapter = createSimulatedAdapter();
+  await assert.rejects(
+    adapter.print({ printer: SIMULATED_PRINTER_NAME, file, copies: 1, colour: false, duplex: false, paper: 'A4', title: 'x' }),
+    (err) => err.code === 'spooler_error',
+  );
+  await assert.rejects(
+    adapter.print({ printer: 'Office', file, copies: 1, colour: false, duplex: false, paper: 'A4', title: 'x' }),
+    (err) => err.code === 'printer_not_found',
+  );
+  assert.equal(adapter.prints.length, 0, 'nothing is recorded as printed');
+});
+
+test('a simulated run records "printing" before the print, then reports sent and says SIMULATED', async (t) => {
+  const h = await harness(t);
+  await h.worker.processJob(job());
+  assert.deepEqual(h.events, ['printing', 'print', 'sent']);
+  assert.equal(h.reports[0].outcome, 'sent');
+  assert.equal(h.adapter.prints[0].spoolerId, 'simulated-1');
+  assert.ok(h.logs.some((l) => l.includes('SIMULATED on')), h.logs.join('\n'));
+  assert.ok(h.logs.every((l) => !l.includes(': sent to ')), 'a simulated job is never logged as sent to a printer');
+});
+
+test('a picture is wrapped in a PDF first, so the simulated spooler receives a PDF', async (t) => {
+  const h = await harness(t, { bytes: JPEG });
+  await h.worker.processJob(job(JPEG));
+  assert.deepEqual(h.events, ['printing', 'print', 'sent']);
+  assert.equal(h.adapter.prints.length, 1);
+});
+
+test('an unknown file type is refused and nothing is simulated', async (t) => {
+  const bytes = Buffer.from('hello, this is not a document');
+  const h = await harness(t, { bytes });
+  await h.worker.processJob(job(bytes));
+  assert.equal(h.reports[0].outcome, 'failed');
+  assert.equal(h.reports[0].errorCode, 'file_type_unknown');
+  assert.deepEqual(h.events, ['failed']);
+  assert.equal(h.adapter.prints.length, 0);
+});
+
+test('a file the server cannot give us is reported once as failed and nothing is simulated', async (t) => {
+  const h = await harness(t, {
+    download: async () => {
+      throw new AgentApiError(404, 'download_failed', 'The file could not be downloaded.');
+    },
+  });
+  await h.worker.processJob(job());
+  assert.equal(h.reports.length, 1);
+  assert.equal(h.reports[0].errorCode, 'download_failed');
+  assert.equal(h.adapter.prints.length, 0);
+});
+
+test('a job the server has already moved on from is not simulated again', async (t) => {
+  let markCalls = 0;
+  const h = await harness(t, {
+    api: {
+      markPrinting: async () => {
+        markCalls += 1;
+        if (markCalls > 1) throw new AgentApiError(409, 'lease_lost', 'The job was taken back.');
+        return { ok: true };
+      },
+    },
+  });
+  await h.worker.processJob(job());
+  await h.worker.processJob(job());
+  assert.equal(h.adapter.prints.length, 1, 'one simulated print for one job');
+  assert.equal(markCalls, 2);
+  assert.ok(h.logs.some((l) => l.includes('not printed')));
+});
+
+test('no answer to "printing" means nothing is simulated and nothing is reported as failed', async (t) => {
+  const h = await harness(t, {
+    api: {
+      markPrinting: async () => {
+        throw new AgentApiError(0, 'network', 'Could not reach QRquick.');
+      },
+    },
+  });
+  await h.worker.processJob(job());
+  assert.equal(h.adapter.prints.length, 0);
+  assert.deepEqual(h.reports, [], 'no failure is reported, so nobody is invited to print again');
+});
+
+test('a result that could not be sent is kept and sent later, without a second simulated print', async (t) => {
+  const finishCalls = [];
+  const h = await harness(t, {
+    api: {
+      finish: async (ref, result) => {
+        finishCalls.push(result.outcome);
+        if (finishCalls.length === 1) throw new AgentApiError(0, 'network', 'Could not reach QRquick.');
+        return { ok: true };
+      },
+    },
+  });
+  await h.worker.processJob(job());
+  assert.equal(h.adapter.prints.length, 1);
+  await h.worker.flushReports();
+  await h.worker.flushReports();
+  assert.deepEqual(finishCalls, ['sent', 'sent'], 'the result is sent once after the first failure, then nothing more');
+  assert.equal(h.adapter.prints.length, 1, 'still one simulated print');
+});
+
+test('a simulated printer that is turned off fails the job before anything is simulated', async (t) => {
+  const h = await harness(t, { adapterOptions: { enabled: false } });
+  await h.worker.processJob(job());
+  assert.equal(h.reports[0].outcome, 'failed');
+  assert.equal(h.reports[0].errorCode, 'printer_offline');
+  assert.deepEqual(h.events, ['failed']);
+});
+
+test('a black-and-white simulated printer refuses a colour order before anything is simulated', async (t) => {
+  const h = await harness(t, { adapterOptions: { colour: false } });
+  await h.worker.processJob(job(PDF, { settings: { copies: 1, colour: true, duplex: false, paper: 'A4' } }));
+  assert.equal(h.reports[0].errorCode, 'unsupported_setting');
+  assert.equal(h.adapter.prints.length, 0);
+});
+
+test('an order for a printer this computer does not have fails as printer_not_found', async (t) => {
+  const h = await harness(t);
+  await h.worker.processJob(job(PDF, { printer: 'Office Laser' }));
+  assert.equal(h.reports[0].errorCode, 'printer_not_found');
+  assert.equal(h.adapter.prints.length, 0);
+});
+
+test('the simulated module never imports the command runner or a real printer adapter', () => {
+  const source = readFileSync(new URL('../src/printers/simulated.mjs', import.meta.url), 'utf8');
+  assert.doesNotMatch(source, /child_process|runner\.mjs|printers\/linux|printers\/windows|powershell|sumatra|execFile|https?:|fetch\(/i);
+});
