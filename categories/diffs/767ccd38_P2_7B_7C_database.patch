+        ("SR-02 limit 0 is invalid_request", f"admin_search_shops({lit(tok)}, 0)"),
+        ("SR-02 limit 26 is invalid_request", f"admin_search_shops({lit(tok)}, 26)"),
+        ("SR-02 a null limit is invalid_request", f"admin_search_shops({lit(tok)}, null)"),
