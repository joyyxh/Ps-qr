# PrintNest environment template.
#
# Copy this file to ".env" on your own computer and fill in real values.
# ".env" is listed in .gitignore, so real values are never committed.
# Never put a service-role or secret key in this file or anywhere in the repository.
#
# The web app does not read this file. Its public settings live in web/config.js
# (project URL and publishable key only).

# Address where the customer page is published, used inside shop QR codes.
# Used by mobile/scripts/copy-web.mjs for the Android build.
# In GitHub, set the same value as a repository VARIABLE (not a secret):
#   Settings > Secrets and variables > Actions > Variables > PRINTNEST_PUBLIC_URL
PRINTNEST_PUBLIC_URL=https://your-printnest-site.example/

# The Supabase edge functions (upload-file, owner-file-link) get their service key
# from the environment Supabase provides. It is not configured here.
